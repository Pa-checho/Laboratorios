
; Proyecto de control de una lavadora mediante
; lenguaje Assembly.


.include "m328pdef.inc"
.org 0x0000


; REGISTROS
.def temp  = r16
.def carga = r17

    rjmp RESET

    ; Inicializacion del Stack Pointer


    ldi r16, high(RAMEND)
    out SPH, r16

    ldi r16, low(RAMEND)
    out SPL, r16

    ; INICIALIZACION DE LA CARGA
    ; 0 = chica
    ; 1 = mediana
    ; 2 = grande
    ; 3 = ninguna

    ldi carga, 3


    ; CONFIGURACION DE PUERTOS
  
    ; PB0-PB5 = salidas para LED1-LED6
    ldi r16, 0b00111111
    out DDRB, r16

    ; PC0-PC3 = salidas para LED7-LED10
    ldi r16, 0b00001111
    out DDRC, r16

    ; PD0-PD3 = entradas para SW1-SW4
    ldi r16, 0b00000000
    out DDRD, r16


    ; Inicia todos los LEDs apagados.
    ldi r16, 0b00000000
    out PORTB, r16

    out PORTC, r16


    ; ESTADO INICIAL
    ; LED1 = Lavadora lista
    sbi PORTB, 0


ESTADO_LISTO:

    ; Mantener LED1 encendido.
    rjmp ESTADO_LISTO
    

RESET:

    rjmp RESET
