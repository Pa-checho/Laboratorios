
; Proyecto de control de una lavadora mediante
; lenguaje Assembly.


.include "m328pdef.inc"
.def temp  = r16
.def carga = r17

.org 0x0000
    rjmp RESET

RESET:

    ; Inicializacion del Stack Pointer
    ldi r16, high(RAMEND)
    out SPH, r16

    ldi r16, low(RAMEND)
    out SPL, r16


    ; INICIALIZACION DE LA CARGA
    ; 0 = chica
    ; 1 = mediana
    ; 2 = grande
    ; 3 = ninguna

    ldi carga, 3


    ; CONFIGURACION DE PUERTOS
    ; PB0-PB5 = salidas para LED1-LED6
    ldi r16, 0b00111111
    out DDRB, r16

    ; PC0-PC3 = salidas para LED7-LED10
    ldi r16, 0b00001111
    out DDRC, r16

    ; PD0-PD3 = entradas para SW1-SW4
    ldi r16, 0b00000000
    out DDRD, r16


    ; Inicia todos los LEDs apagados.
    ldi r16, 0b00000000
    out PORTB, r16

    out PORTC, r16


    ; ESTADO INICIAL
    ; LED1 = Lavadora lista
    sbi PORTB, 0

    rcall MOSTRAR_CARGA


ESTADO_LISTO:

    sbi PORTB, 0

    rcall MOSTRAR_CARGA


ESPERAR_LISTO:

    ;=====================================================
    ;                 COMPROBAR SW2
    ;=====================================================

    ;-----------------------------------------------------
    ; PD1 = 1 -> SW2 presionado.
    ;-----------------------------------------------------

    sbis PIND, 1

    rjmp COMPROBAR_SW1


    ;-----------------------------------------------------
    ; Antirrebote.
    ;-----------------------------------------------------

    rcall DELAY_REBOTE


    ;-----------------------------------------------------
    ; Confirmar que SW2 continúa presionado.
    ;-----------------------------------------------------

    sbic PIND, 1

    rjmp SELECCIONAR_CARGA


    rjmp ESPERAR_LISTO




COMPROBAR_SW1:

;=========================================================
;                 INICIAR LAVADORA
;=========================================================

INICIAR_LAVADORA:

    ;-----------------------------------------------------
    ; Comprobar si existe una carga seleccionada.
    ;
    ; carga = 3 -> ninguna carga.
    ;-----------------------------------------------------

    cpi carga, 3

    breq ESPERAR_LISTO


    ;-----------------------------------------------------
    ; Por ahora solamente indicamos que el programa
    ; recibió la orden de inicio.
    ;
    ; El proceso de lavado se agregará posteriormente.
    ;-----------------------------------------------------

    rjmp PROCESO_INICIADO



;=========================================================
;                 PROCESO INICIADO
;=========================================================

PROCESO_INICIADO:

    ;-----------------------------------------------------
    ; LED2 = proceso de lavado.
    ;-----------------------------------------------------

    sbi PORTB, 1


    ;-----------------------------------------------------
    ; Por ahora permanecer aquí.
    ;
    ; En el siguiente cambio agregaremos el proceso
    ; completo de lavado.
    ;-----------------------------------------------------

    rjmp PROCESO_INICIADO

    ;-----------------------------------------------------
    ; PD0 = 1 -> SW1 presionado.
    ;-----------------------------------------------------

    sbis PIND, 0

    rjmp ESPERAR_LISTO



    ; Antirrebote.
    rcall DELAY_REBOTE

    ; Confirmar que SW1 continúa presionado.

    sbic PIND, 0

    rjmp INICIAR_LAVADORA


    rjmp ESPERAR_LISTO



; MOSTRAR CARGA
; carga = 0 -> LED7 = CHICA
; carga = 1 -> LED8 = MEDIANA
; carga = 2 -> LED9 = GRANDE
; carga = 3 -> Ninguna


MOSTRAR_CARGA:

    cbi PORTC, 0
    cbi PORTC, 1
    cbi PORTC, 2


    
    ; Comprobar si es carga chica.
    cpi carga, 0
    breq CARGA_CHICA


    ; Comprobar si es carga mediana.
    cpi carga, 1
    breq CARGA_MEDIANA


    ; Comprobar si es carga grande.
     cpi carga, 2
     breq CARGA_GRANDE

    ; carga = 3
    ; No hay carga seleccionada.

    ret


CARGA_CHICA:

    ; LED7 = ON
    sbi PORTC, 0
    ret


CARGA_MEDIANA:

    ; LED8 = ON
    sbi PORTC, 1
    ret



CARGA_GRANDE:

    ; LED9 = ON
    sbi PORTC, 2
    ret
    
;=========================================================
;                 SELECCIONAR CARGA
;=========================================================
;
; SW2 = PD1
;
; Mientras SW2 permanezca presionado:
;
; 0 = CHICA
; 1 = MEDIANA
; 2 = GRANDE
;
; La selección cambia cada 1 segundo.
;
;=========================================================

SELECCIONAR_CARGA:

    ;-----------------------------------------------------
    ; Cambiar a la siguiente carga.
    ;-----------------------------------------------------

    inc carga


    ;-----------------------------------------------------
    ; Si carga llega a 3, volver a chica.
    ;-----------------------------------------------------

    cpi carga, 3

    brlo CARGA_VALIDADA

    ldi carga, 0


CARGA_VALIDADA:

    ;-----------------------------------------------------
    ; Mostrar el LED correspondiente.
    ;-----------------------------------------------------

    rcall MOSTRAR_CARGA


    ;-----------------------------------------------------
    ; Esperar aproximadamente 1 segundo.
    ;-----------------------------------------------------

    rcall DELAY_1S


    ; Comprobar si SW2 continúa presionado.

    ; PD1 = 1 -> continuar seleccionando.
    ; PD1 = 0 -> terminar selección.

    sbis PIND, 1

    rjmp CARGA_SELECCIONADA
    rjmp SELECCIONAR_CARGA



CARGA_SELECCIONADA:

    ; La carga queda almacenada en "carga".

    rjmp ESTADO_LISTO



DELAY_1S:

    ldi r20, 64


; DELAY ANTIRREBOTE
; Pequeño retardo utilizado para estabilizar
; la lectura de los interruptores.

DELAY_REBOTE:

    ldi r20, 10


REBOTE_1:

    ldi r21, 255


REBOTE_2:

    dec r21

    brne REBOTE_2


    dec r20

    brne REBOTE_1


    ret


DELAY_1:

    ldi r21, 250


DELAY_2:

    ldi r22, 250


DELAY_3:

    dec r22

    brne DELAY_3


    dec r21

    brne DELAY_2


    dec r20

    brne DELAY_1


    ret
