

.include "m328pdef.inc"
.def temp  = r16
.def carga = r17

.org 0x0000
    rjmp RESET

RESET:

    ; Inicializacion del Stack Pointer
    ldi r16, high(RAMEND)
    out SPH, r16

    ldi r16, low(RAMEND)
    out SPL, r16


    ; INICIALIZACION DE LA CARGA
    ; 0 = chica
    ; 1 = mediana
    ; 2 = grande
    ; 3 = ninguna

    ldi carga, 3


    ; CONFIGURACION DE PUERTOS 
    ; PB0-PB5 = salidas para LED1-LED6
    ldi r16, 0b00111111
    out DDRB, r16

    ; PC0-PC3 = salidas para LED7-LED10
    ldi r16, 0b00001111
    out DDRC, r16

    ; PD0-PD3 = entradas para SW1-SW4
    ldi r16, 0b00000000
    out DDRD, r16


    ; Inicia todos los LEDs apagados.
    ldi r16, 0
    out PORTD, r16
    out PORTB, r16
    out PORTC, r16

    rjmp ESTADO_LISTO

ESTADO_LISTO:
    ; LED1 = Lavadora lista
    sbi PORTB, 0

    ; Mostrar carga seleccionada
    rcall MOSTRAR_CARGA


ESPERAR_LISTO:
    ; COMPROBAR SW2
    ; PD1 = 1 -> SW2 presionado.
    sbis PIND, 1
    rjmp COMPROBAR_SW1

    ; Antirrebote.
    rcall DELAY_REBOTE

    ; Confirmar que SW2 continúa presionado.
    sbic PIND, 1
    rjmp SELECCIONAR_CARGA
    rjmp ESPERAR_LISTO




COMPROBAR_SW1:
    ; Revisar SW1
    ; PD0 = 1
    sbis PIND, 0
    
    rjmp ESPERAR_LISTO

    ; Antirrebote
    rcall DELAY_REBOTE

    ; Confirmar pulsación
    sbic PIND, 0
    rjmp INICIAR_LAVADORA
    rjmp ESPERAR_LISTO


INICIAR_LAVADORA:
; Verificar que exista una carga seleccionada

    cpi carga, 3
    breq ESPERAR_LISTO
    rjmp VERIFICAR_CONDICIONES



VERIFICAR_CONDICIONES:

ESPERAR_PUERTA:
    sbis PIND, 2
    rjmp ESPERAR_PUERTA


ESPERAR_AGUA:
    sbis PIND, 3
    rjmp ESPERAR_AGUA
    rjmp PROCESO_INICIADO

PROCESO_INICIADO:

    ;-----------------------------------------------------
    ; LED2 = proceso de lavado
    ;-----------------------------------------------------

    sbi PORTB, 1
    rcall PROCESO_LAVADO
    rjmp ESTADO_LISTO


; PROCESO DE LAVADO
;
; 5 ciclos de:
;
;    GIRAR  -> LED5 ON
;    PAUSA  -> LED5 OFF
;
; Ajuste por carga:
;
; CHICA   -> 2 s giro / 1 s pausa
; MEDIANA -> 3 s giro / 2 s pausa
; GRANDE  -> 4 s giro / 3 s pausa


PROCESO_LAVADO:

    ; Contador de ciclos
    ; Se realizarán 5 ciclos.

    ldi r18, 5


CICLO_LAVADO:
    ; Encender LED5.
    ; LED5 representa el giro del tambor.
 

    sbi PORTB, 4

    ; Determinar tiempo de giro según carga.
 
    cpi carga, 0
    breq GIRO_CHICA
    cpi carga, 1
    breq GIRO_MEDIANA

    ; Si no es chica ni mediana,
    ; corresponde a carga grande.

    rjmp GIRO_GRANDE


GIRO_CHICA:
    rcall DELAY_2S
    rjmp FIN_GIRO


GIRO_MEDIANA:
    rcall DELAY_3S
    rjmp FIN_GIRO


GIRO_GRANDE:
    rcall DELAY_4S


FIN_GIRO:
    ; Apagar LED5.
    ; El tambor deja de girar.


    cbi PORTB, 4

    ; Determinar tiempo de pausa según carga.

    cpi carga, 0
    breq PAUSA_CHICA
    cpi carga, 1
    breq PAUSA_MEDIANA
    rjmp PAUSA_GRANDE


PAUSA_CHICA:
    rcall DELAY_1S
    rjmp FIN_PAUSA


PAUSA_MEDIANA:
    rcall DELAY_2S
    rjmp FIN_PAUSA


PAUSA_GRANDE:
    rcall DELAY_3S


FIN_PAUSA:
    dec r18
    brne CICLO_LAVADO
    ret
    

; SW2 = PD1
;
; Mientras SW2 permanezca presionado:
;
; 0 = CHICA
; 1 = MEDIANA
; 2 = GRANDE
;
; La selección cambia cada 1 segundo.


SELECCIONAR_CARGA:
    inc carga
    cpi carga, 3
    brlo CARGA_VALIDADA
    ldi carga, 0


CARGA_VALIDADA:
    rcall MOSTRAR_CARGA
    rcall DELAY_1S


    ; Comprobar si SW2 continúa presionado.
    ; PD1 = 1 -> continuar seleccionando.
    ; PD1 = 0 -> terminar selección.

    sbis PIND, 1

    rjmp CARGA_SELECCIONADA
    rjmp SELECCIONAR_CARGA



CARGA_SELECCIONADA:

    rjmp ESTADO_LISTO

; MOSTRAR CARGA
; carga = 0 -> LED7 = CHICA
; carga = 1 -> LED8 = MEDIANA
; carga = 2 -> LED9 = GRANDE
; carga = 3 -> Ninguna


MOSTRAR_CARGA:
    cbi PORTC, 0
    cbi PORTC, 1
    cbi PORTC, 2
    
    ; Comprobar si es carga chica.
    cpi carga, 0
    breq CARGA_CHICA


    ; Comprobar si es carga mediana.
    cpi carga, 1
    breq CARGA_MEDIANA


    ; Comprobar si es carga grande.
     cpi carga, 2
     breq CARGA_GRANDE

    ; carga = 3
    ; No hay carga seleccionada.
    ret


CARGA_CHICA:
    ; LED7 = ON
    sbi PORTC, 0
    ret


CARGA_MEDIANA:
    ; LED8 = ON
    sbi PORTC, 1
    ret


CARGA_GRANDE:
    ; LED9 = ON
    sbi PORTC, 2
    ret

DELAY_1S:
    ldi r20, 64

DELAY_2S:
    rcall DELAY_1S
    rcall DELAY_1S
    ret


DELAY_3S:
    rcall DELAY_1S
    rcall DELAY_1S
    rcall DELAY_1S
    ret

DELAY_4S:
    rcall DELAY_1S
    rcall DELAY_1S
    rcall DELAY_1S
    rcall DELAY_1S
    ret

DELAY_1:
    ldi r21, 250

DELAY_2:
    ldi r22, 250

DELAY_3:
    dec r22
    brne DELAY_3
    dec r21
    brne DELAY_2
    dec r20
    brne DELAY_1
    ret


; DELAY ANTIRREBOTE
; Pequeño retardo utilizado para estabilizar lectura de los interruptores

DELAY_REBOTE:
    ldi r20, 10

REBOTE_1:
    ldi r21, 255

REBOTE_2:
    dec r21
    brne REBOTE_2
    dec r20
    brne REBOTE_1
    ret



