.include "m328pdef.inc"
.cseg
.org 0x0000
  rjmp RESET

RESET:
  ldi r16, high(RAMEND)
  out SPH, r16

  ldi r16, low(RAMEND)
  out SPL, r16

  ldi r16, 0xFF
  out DDRD, r16

  ldi r17, 1
  out PORTD,17

  ldi r16, 0x00
  out DDRB, r16

  ldi r16, 0x07
  out PORTB, r16

MAIN:
  sbis PINB, PB0
  rjmp POSIBLE_PULSACION
  rjmp MAIN

POSIBLE_PULSACION:
  rcall RETARDO_REBOTE
  sbis PINB, PB0
  rjmp BOTON_SIGUIENTE
  rjmp MAIN
BOTON_SIGUIENTE:
  inc r17
  cpi r17, 9
  brlo MOSTRAR_SECUENCIA
  ldi r17, 1

MOSTRAR_SECUENCIA:
  out PORTD, r17

ESPERAR_LIBERACION:
  sbis PINB, PB0
  rjmp ESPERAR_LIBERACION
  rcall RETARDO_REBOTE
  sbis PINB, PB0
  rjmp ESPERAR_LIBERACION
  rjmp MAIN

RETARDO_REBOTE:
  ldi r18,2

REBOTE_1:
  ldi r19, 255

REBOTE_2:
  ldi r20, 255
REBOTE_3:
  dec r20
  brne REBOTE_3

  dec r19
  BRNE REBOTE_2

  dec r18
  brne REBOTE_1

  ret







