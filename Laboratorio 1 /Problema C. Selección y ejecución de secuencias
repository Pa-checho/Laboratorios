.include "m328pdef.inc"
.cseg
.org 0x0000
  rjmp RESET

RESET:
  ldi r16, high(RAMEND)
  out SPH, r16

  ldi r16, low(RAMEND)
  out SPL, r16

  ldi r16, 0xFF
  out DDRD, r16

  ldi r17, 1
  out PORTD, r17

  ldi r16, 0x00
  out DDRB, r16

  ldi r16, 0x07
  out PORTB, r16

MAIN:
  sbis PINB, PB0
  rjmp POSIBLE_PULSACION

  sbis PINB, PB1
  rjmp POSIBLE_ANTERIOR

  sbis PINB, PB2
  rjmp POSIBLE_REINICIO

  rjmp MAIN
POSIBLE_REINICIO:
  rcall RETARDO_REBOTE
  sbis PINB, PB2
  rjmp BOTON_REINICIO
  rjmp MAIN

BOTON_REINICIO:
  ldi r17, 1
  out PORTD, r17
  rjmp ESPERAR_LIBERACION_PB2

ESPERAR_LIBERACION_PB2:
  sbis PINB, PB2
  rjmp ESPERAR_LIBERACION_PB2
  rcall RETARDO_REBOTE

  sbis PINB, PB2
  rjmp ESPERAR_LIBERACION_PB2
  rjmp MAIN


POSIBLE_PULSACION:
  rcall RETARDO_REBOTE
  sbis PINB, PB0
  rjmp BOTON_SIGUIENTE
  rjmp MAIN
BOTON_SIGUIENTE:
  inc r17
  cpi r17, 9
  brlo MOSTRAR_SECUENCIA
  ldi r17, 1

MOSTRAR_SECUENCIA:
  out PORTD, r17
  rjmp ESPERAR_LIBERACION_PB0

ESPERAR_LIBERACION_PB0:
  sbis PINB, PB0
  rjmp ESPERAR_LIBERACION_PB0
  rcall RETARDO_REBOTE
  sbis PINB, PB0
  rjmp ESPERAR_LIBERACION_PB0
  rjmp MAIN

POSIBLE_ANTERIOR:
  rcall RETARDO_REBOTE
  sbis PINB, PB1
  rjmp BOTON_ANTERIOR
  rjmp MAIN

BOTON_ANTERIOR:
  cpi r17, 1
  breq ANTERIOR_A_OCHO

  dec r17
  rjmp MOSTRAR_ANTERIOR

ANTERIOR_A_OCHO:
  ldi r17, 8

MOSTRAR_ANTERIOR:
  out PORTD, r17
  rjmp ESPERAR_LIBERACION_PB1

ESPERAR_LIBERACION_PB1:
  sbis PINB,PB1
  rjmp ESPERAR_LIBERACION_PB1
  rcall RETARDO_REBOTE
  sbis PINB, PB1
  rjmp ESPERAR_LIBERACION_PB1
  rjmp MAIN

  




RETARDO_REBOTE:
  ldi r18,2

REBOTE_1:
  ldi r19, 255

REBOTE_2:
  ldi r20, 255
REBOTE_3:
  dec r20
  brne REBOTE_3

  dec r19
  brne REBOTE_2

  dec r18
  brne REBOTE_1

  ret







