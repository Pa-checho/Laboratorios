.include "m328pdef.inc"
.cseg
.org 0x0000
  rjmp RESET

RESET:
  ldi r16, high(RAMEND)
  out SPH, r16

  ldi r16, low(RAMEND)
  out SPL, r16

  ldi r16, 0xFF
  out DDRD, r16

  ldi r16, 0x00
  out PORTD, r16

  ldi r16, 0x00
  out DDRB, r16

  ldi r16, 0x07
  out PORTB, r16

MAIN:
  ldi r16, 0xAA
  out PORTD, r16

  rcall RETARDO

  ldi r16, 0x55
  out PORTD, r16

  rcall RETARDO

  rjmp MAIN

RETARDO:
  ldi r18, 41

RETARDO_1:
  ldi r19, 255
RETARDO_2:
  ldi r20, 255
RETARDO_3:
  dec r20
  brne RETARDO_3

  dec r19
  brne RETARDO_2

  dec r18
  brne RETARDO_1
  ret





