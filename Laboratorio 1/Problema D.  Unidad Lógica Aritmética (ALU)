.include "m328pef.inc"

.def lectura_data = r16 ;Entrada puerto B (A y B)
.def numA = r17         ;Operador A
.def numB = r18         ;Operador B
.def selector = r19     ;Selector S
.def resultado = r20    ;Resultado F
.def temp = r21    ;Compia de flags
.def lectura = r22         ;Auxiliar 

.org 0x0000
rjmp setup

;Configuracion de puertos 
setup:
    clr temp
    out DDRB, temp        ;Puerto B: Entradas (PB0-PB3 = A)
    out DDRC, temp        ;Puerto C: Entradas (A0-A3 = B)
    
    ser temp
    out DDRD, temp        ;Puerto D: Salidas (Resultado F)

;Bucle Principal (Lectura)
loop:
;Leer operador A
    in numA, PINB
    andi numA, 0x0F

;Leer operador B
    in numB, PINC
    andi numA, 0x0F

;Leer selector
    in temp, PINC
    lsr temp
    lsr temp
    lsr temp
    lsr temp
    andi temp, 0x03       ;temp tiene S0 y S1

    in lectura, PINB
    sbrc lectura, 4       ;Si D12 (PB4) es 1
    sbr temp, 0x04        ;Activa el bit S2
    
    mov selector, temp   ;Selector completo (0 a 7)

;Enrutador del Selector
    cpi selector, 0
    breq op_clear
    cpi selector, 1
    breq op_sub
    cpi selector, 2
    breq op_add
    cpi selector, 3
    breq op_xor
    cpi selector, 4
    breq op_and
    cpi selector, 5
    breq op_or
    cpi selector, 6
    breq op_shl
    cpi selector, 7
    breq op_inc
    rjmp loop

;Operaciones ALU
op_clear:
    clr resultado         ;Borra el valor de resultado dejando 0
    rjmp evaluar_flags

op_sub:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    sub resultado, numB  ;Resta el valor de resultado - numB guardando el resultado, en resultado
    rjmp evaluar_flags

op_add:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    add resultado, numB  ;Suma el valor de resultado + numB guardando el resultado, en resultado
    rjmp evaluar_flags

op_xor:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    eor resultado, numB  ;resultado xor numB guardando el resultado, en resultado
    rjmp evaluar_flags

op_and:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    and resultado, numB  ;resultado and numB guardando el resultado, en resultado
    rjmp evaluar_flags

op_or:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    or resultado, numB   ;resultado or numB guardando el resultado, en resultado
    rjmp evaluar_flags

op_shl:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    lsl resultado        ;resultado es desplazado hacia la derecha
    rjmp evaluar_flags

op_inc:
    mov resultado, numA  ;Mueve el valor de numA hacia resultado
    subi resultado, -1   ;suma 1 al valor de resultado
    rjmp evaluar_flags

;Manejo de Salidas y Banderas
evaluar_flags: 
    clr temp

;Evaluar Signo
    sbrc resltado, 7
    sbr temp,(1<<6)   ;Activa D6 si es negativo

;Evaluar CARRY
    sbrc resultado, 4
    sbr temp, (1<<4)   ;Activa D4

;Recorta resultado a 4 bits para los LEDs de salida
    brn no_es_cero
    sbr temp, (1<<5)    ;Activa D5

no_es_cero:
    ;unir resultados (D0-D3) y flags (D4-D6) en el puerto D
    or resultado, temp
    out PORTD, resultado

    rjmp loop

