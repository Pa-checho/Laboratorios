;              LAVADORA AUTOMATICA
;                  ATmega328P
;
; SWITCHES CON PULL-UP EXTERNO
;
; Switch accionado = 0
; Switch liberado  = 1
;
; ENTRADAS
;
; D0 = PD0 = SW1 -> INICIO / REINICIO
; D1 = PD1 = SW2 -> SELECCION DE CARGA
; D2 = PD2 = SW3 -> PUERTA / INT0
; D3 = PD3 = SW4 -> AGUA / INT1
;
; SALIDAS
;
; D4  = PD4 = LED1  -> LISTO
; D5  = PD5 = LED2  -> LAVADO
; D6  = PD6 = LED3  -> CENTRIFUGADO
; D7  = PD7 = LED4  -> SECADO
; D8  = PB0 = LED5  -> GIRO IZQUIERDA
; D9  = PB1 = LED6  -> GIRO DERECHA
; D10 = PB2 = LED7  -> CARGA CHICA
; D11 = PB3 = LED8  -> CARGA MEDIANA
; D12 = PB4 = LED9  -> CARGA GRANDE
; D13 = PB5 = LED10 -> FIN

.include "m328pdef.inc"

.def temp   = r16
.def carga  = r17
.def ciclos = r18
.def tiempo = r19


; VECTORES DE INTERRUPCION
.org 0x0000
    rjmp RESET

; INT0 -> D2 -> SW3
.org INT0addr
    rjmp ISR_SEGURIDAD


; INT1 -> D3 -> SW4
.org INT1addr
    rjmp ISR_SEGURIDAD


.org 0x0034


RESET:

    cli

    ldi temp, high(RAMEND)
    out SPH, temp

    ldi temp, low(RAMEND)
    out SPL, temp


    ; PORTD
    ; PD0-PD3 = entradas
    ; PD4-PD7 = salidas
    ldi temp, 0b11110000
    out DDRD, temp


    ; PORTB
    ; PB0-PB5 = salidas
    ldi temp, 0b00111111
    out DDRB, temp


  
    ; Pull-up internos DESACTIVADOS
    ; Se utilizan pull-up externos.
    ldi temp, 0
    out PORTD, temp

    out PORTB, temp


   
    ; CONFIGURAR INTERRUPCIONES EXTERNAS
    ;
    ; SW3 y SW4:
    ; Condición correcta = LOW
    ; Condición peligrosa = HIGH
    ;
    ; La interrupción debe ocurrir:
    ;
    ; LOW -> HIGH
    ;
    ; FLANCO DE SUBIDA
    ;
    ; INT0:
    ; ISC01 = 1
    ; ISC00 = 1
    ;
    ; INT1:
    ; ISC11 = 1
    ; ISC10 = 1
    ;
    ;=====================================================

    ldi temp, (1<<ISC01) | (1<<ISC00) | (1<<ISC11) | (1<<ISC10)

    sts EICRA, temp


    ; Inicialmente deshabilitadas
    ldi temp, 0
    out EIMSK, temp


    ; Limpiar banderas
	ldi temp, (1<<INTF0) | (1<<INTF1)
    out EIFR, temp


    sei

    ; 3 = ninguna carga
    ldi carga, 3


    rjmp ESTADO_LISTO


ESTADO_LISTO:

    rcall APAGAR_LEDS


    ; LED1 = D4

    sbi PORTD, 4


    rcall MOSTRAR_CARGA



ESPERAR_LISTO:

    
    ; SW2 = D1
    ; ACCIONADO = LOW
    sbic PIND, 1
    rjmp REVISAR_SW1


    ; Antirrebote
    rcall DELAY_REBOTE


    ; Confirmar que sigue en LOW
    sbis PIND, 1
    rjmp SELECCIONAR_CARGA
    rjmp ESPERAR_LISTO



REVISAR_SW1:

    ; SW1 accionado = LOW
    sbic PIND, 0
    rjmp ESPERAR_LISTO


    ; Debe haber carga seleccionada
    cpi carga, 3
    breq ESPERAR_LISTO
    rcall DELAY_REBOTE

    ; Confirmar SW1
    sbis PIND, 0
    rjmp INICIAR_PROCESO
    rjmp ESPERAR_LISTO



INICIAR_PROCESO:

    ; Esperar que SW1 vuelva a HIGH
    rcall ESPERAR_SOLTAR_SW1


    ; Verificar puerta y agua
    rcall VERIFICAR_CONDICIONES


    ; Limpiar banderas anteriores
    ldi temp, (1<<INTF0) | (1<<INTF1)
    out EIFR, temp


    
    ; Habilitar INT0 e INT1
    ldi temp, (1<<INT0) | (1<<INT1)
    out EIMSK, temp


    rcall ESTADO_LAVADO
    rcall ESTADO_CENTRIFUGADO
    rcall ESTADO_SECADO


 
    ; Deshabilitar interrupciones de seguridad
    ldi temp, 0
    out EIMSK, temp
    rcall ESTADO_FIN
    rjmp ESTADO_LISTO




SELECCIONAR_CARGA:

   
    ; Cambiar inmediatamente
    inc carga


    ; Si supera 2 -> volver a 0
    cpi carga, 3
    brlo CARGA_VALIDA
    ldi carga, 0



CARGA_VALIDA:

    rcall MOSTRAR_CARGA




SELECCION_CARGA_LOOP:

    ; Si SW2 pasa a HIGH, terminar
    sbic PIND, 1
    rjmp CARGA_SELECCIONADA


    ; Esperar aproximadamente 1 segundo
    ldi tiempo, 1
    rcall DELAY_CARGA


    ; Revisar nuevamente
    sbic PIND, 1
    rjmp CARGA_SELECCIONADA


    ; Cambiar carga
    inc carga
    cpi carga, 3
    brlo CARGA_VALIDA_CONT
    ldi carga, 0



CARGA_VALIDA_CONT:

    rcall MOSTRAR_CARGA
    rjmp SELECCION_CARGA_LOOP



CARGA_SELECCIONADA:

    rcall DELAY_REBOTE
    rjmp ESTADO_LISTO



DELAY_CARGA:


DELAY_CARGA_LOOP:

    rcall DELAY_1S
    dec tiempo
    brne DELAY_CARGA_LOOP
    ret



ESPERAR_SOLTAR_SW1:


SOLTAR_SW1:

    ; Mientras SW1 = LOW seguir esperando
    ; Si está HIGH, SBIC salta el RJMP.
    sbis PIND, 0
    rjmp SOLTAR_SW1
    ret



; VERIFICAR CONDICIONES
; Con pull-up externo:
; SW3 = LOW -> puerta cerrada
; SW4 = LOW -> agua disponible


VERIFICAR_CONDICIONES:


ESPERAR_PUERTA:

    ; SW1 LOW permite cancelar
    sbic PIND, 0
    rjmp COMPROBAR_PUERTA
    rjmp REINICIAR



COMPROBAR_PUERTA:

    ; PD2 debe estar LOW
    ; SBIC:
    ; si PD2 = 0 salta RJMP
    sbic PIND, 2
    rjmp ESPERAR_PUERTA


ESPERAR_AGUA:

    ; SW1 permite cancelar
    sbic PIND, 0
    rjmp COMPROBAR_AGUA
    rjmp REINICIAR



COMPROBAR_AGUA:

    ; PD3 debe estar LOW
    sbic PIND, 3
    rjmp ESPERAR_AGUA
    ret



; INTERRUPCION SEGURIDAD
;
; INT0 = SW3
; INT1 = SW4
;
; Si alguno pasa:
;
; LOW -> HIGH
; detener motor.


ISR_SEGURIDAD:

    ; Guardar r16
    push temp

    ; Guardar SREG
    in temp, SREG
    push temp


    ; Guardar PORTB
    ; Aquí están LED5 y LED6
    in temp, PORTB
    push temp


    ; APAGAR MOTOR
    ; D8 = PB0 = izquierda
    ; D9 = PB1 = derecha

    cbi PORTB, 0
    cbi PORTB, 1




ESPERAR_SEGURIDAD:

    ; SW3 debe volver a LOW
    ; Si PD2 = HIGH seguir esperando
    sbic PIND, 2
    rjmp ESPERAR_SEGURIDAD


    ; SW4 debe volver a LOW
    sbic PIND, 3
    rjmp ESPERAR_SEGURIDAD


    ; SW3 = LOW
    ; SW4 = LOW
    ; Condiciones correctas


    ; Recuperar PORTB
    pop temp
    out PORTB, temp

    ; Recuperar SREG
    pop temp
    out SREG, temp

    ; Recuperar r16
    pop temp
    reti


ESTADO_LAVADO:

    rcall APAGAR_LEDS

    ; LED2 = D5
    sbi PORTD, 5

    ; 5 ciclos
    ldi ciclos, 5



CICLO_LAVADO:

    ; LED5 = giro izquierda = D8
    sbi PORTB, 0

    rcall TIEMPO_LAVADO_GIRO

    cbi PORTB, 0

    ; Pausa
    rcall TIEMPO_LAVADO_PAUSA
    dec ciclos
    brne CICLO_LAVADO
    ret




; TIEMPO GIRO LAVADO
; CHICA   = 3 segundos
; MEDIANA = 4 segundos
; GRANDE  = 5 segundos

TIEMPO_LAVADO_GIRO:

    cpi carga, 0
    breq GIRO_CHICA
    cpi carga, 1
    breq GIRO_MEDIANA


    ldi tiempo, 5
    rcall EJECUTAR_SEGUNDOS
    ret



GIRO_CHICA:

    ldi tiempo, 3
    rcall EJECUTAR_SEGUNDOS
    ret



GIRO_MEDIANA:

    ldi tiempo, 4
    rcall EJECUTAR_SEGUNDOS
    ret



; TIEMPO PAUSA LAVADO
;
; CHICA   = 2 segundos
; MEDIANA = 3 segundos
; GRANDE  = 4 segundos

TIEMPO_LAVADO_PAUSA:

    cpi carga, 0
    breq PAUSA_CHICA
    cpi carga, 1
    breq PAUSA_MEDIANA
    ldi tiempo, 4
    rcall EJECUTAR_SEGUNDOS
    ret


PAUSA_CHICA:

    ldi tiempo, 2
    rcall EJECUTAR_SEGUNDOS
    ret



PAUSA_MEDIANA:

    ldi tiempo, 3
    rcall EJECUTAR_SEGUNDOS
    ret



; ESTADO CENTRIFUGADO
; LED3 = D6
; LED5 = D8
;
; CHICA   = 18 segundos
; MEDIANA = 21 segundos
; GRANDE  = 24 segundos


ESTADO_CENTRIFUGADO:

    rcall APAGAR_LEDS

    ; LED3
    sbi PORTD, 6


    ; Motor
    sbi PORTB, 0
    cpi carga, 0
    breq CENT_CHICA


    cpi carga, 1
    breq CENT_MEDIANA


    ; Grande
    ldi tiempo, 24
    rcall EJECUTAR_SEGUNDOS
    rjmp FIN_CENTRIFUGADO



CENT_CHICA:
    ldi tiempo, 18
    rcall EJECUTAR_SEGUNDOS
    rjmp FIN_CENTRIFUGADO



CENT_MEDIANA:
    ldi tiempo, 21
    rcall EJECUTAR_SEGUNDOS



FIN_CENTRIFUGADO:
    cbi PORTB, 0
    ret


; ESTADO SECADO
;
; LED4 = D7
; LED5 = D8
; LED6 = D9

ESTADO_SECADO:

    rcall APAGAR_LEDS


    ; LED4
    sbi PORTD, 7


    ; GIRO DERECHA
    ; D9 = PB1
    sbi PORTB, 1

    rcall TIEMPO_SECADO_GIRO
    cbi PORTB, 1


    ; PAUSA
    ldi tiempo, 3
    rcall EJECUTAR_SEGUNDOS


    ; GIRO IZQUIERDA
    ; D8 = PB0

    sbi PORTB, 0
    rcall TIEMPO_SECADO_GIRO
    cbi PORTB, 0
    ret




; TIEMPO GIRO SECADO
; CHICA   = 7 segundos
; MEDIANA = 9 segundos
; GRANDE  = 11 segundos

TIEMPO_SECADO_GIRO:

    cpi carga, 0
    breq SEC_CHICA
    cpi carga, 1
    breq SEC_MEDIANA
    ldi tiempo, 11
    rcall EJECUTAR_SEGUNDOS
    ret



SEC_CHICA:

    ldi tiempo, 7
    rcall EJECUTAR_SEGUNDOS
    ret



SEC_MEDIANA:

    ldi tiempo, 9
    rcall EJECUTAR_SEGUNDOS
    ret




; ESTADO FIN
; LED10 = D13 = PB5

ESTADO_FIN:

    rcall APAGAR_LEDS

    ; LED10
    sbi PORTB, 5



ESPERAR_FIN:


    ; Esperar SW1 accionado = LOW
    sbic PIND, 0
    rjmp ESPERAR_FIN
    rcall DELAY_REBOTE


    ; Confirmar
    sbis PIND, 0
    rjmp FIN_CONFIRMADO
    rjmp ESPERAR_FIN



FIN_CONFIRMADO:

    rcall ESPERAR_SOLTAR_SW1
    ret



; MOSTRAR CARGA
; LED7 = D10 = PB2
; LED8 = D11 = PB3
; LED9 = D12 = PB4

MOSTRAR_CARGA:

    ; Apagar carga anterior
    cbi PORTB, 2
    cbi PORTB, 3
    cbi PORTB, 4
    cpi carga, 0
    breq CARGA_CHICA
    cpi carga, 1
    breq CARGA_MEDIANA
    cpi carga, 2
    breq CARGA_GRANDE

    ret



CARGA_CHICA:

    sbi PORTB, 2
    ret



CARGA_MEDIANA:

    sbi PORTB, 3
    ret



CARGA_GRANDE:

    sbi PORTB, 4
    ret




APAGAR_LEDS:

    ldi temp, 0
    out PORTD, temp
    ; D8-D13
    out PORTB, temp
    ret



EJECUTAR_SEGUNDOS:


BUCLE_SEGUNDOS:

    ; SW1 accionado = LOW
    ; Reinicio durante proceso.
    sbic PIND, 0

    rjmp CONTINUAR_DELAY
    rjmp REINICIAR



CONTINUAR_DELAY:

    rcall DELAY_1S
    dec tiempo
    brne BUCLE_SEGUNDOS
    ret



DELAY_1S:

    ldi r20, 64

DELAY_1:

    ldi r21, 250

DELAY_2:

    ldi r22, 250

DELAY_3:

    dec r22
    brne DELAY_3
    dec r21
    brne DELAY_2
    dec r20
    brne DELAY_1

    ret



; ANTIRREBOTE

DELAY_REBOTE:

    ldi r20, 10

REBOTE_1:

    ldi r21, 255

REBOTE_2:

    dec r21
    brne REBOTE_2
    dec r20

    brne REBOTE_1


    ret


REINICIAR:

    ; Deshabilitar INT0 / INT1

    ldi temp, 0
    out EIMSK, temp

    ; Apagar LEDs
    out PORTD, temp
    out PORTB, temp

    ; Reiniciar Stack Pointer
    ldi temp, high(RAMEND)
    out SPH, temp
    ldi temp, low(RAMEND)
    out SPL, temp

    ldi carga, 3

    ; Limpiar interrupciones pendientes
    ldi temp, (1<<INTF0) | (1<<INTF1)
    out EIFR, temp
    rjmp ESTADO_LISTO
