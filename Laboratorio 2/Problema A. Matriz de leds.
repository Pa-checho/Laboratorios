.include "m328pdef.inc"

.equ INTENSIDAD_MATRIZ = 3
.equ MAX_DECODE_MODE   = 0x09
.equ MAX_INTENSITY     = 0x0A
.equ MAX_SCAN_LIMIT    = 0x0B
.equ MAX_SHUTDOWN      = 0x0C
.equ MAX_DISPLAY_TEST  = 0x0F

.dseg
imagen_actual: .byte 1
actualizar_matriz: .byte 1 



.cseg
.org 0x0000
    rjmp RESET
.org INT0addr
    rjmp ISR_INT0
.org INT1addr
    rjmp ISR_INT1
.org INT_VECTORS_SIZE

RESET:
    cli

    ; Inicializar la pila para poder utilizar RCALL y RET.
    ldi r16, high(RAMEND)
    out SPH, r16
    ldi r16, low(RAMEND)
    out SPL, r16

    ; SPI hacia MAX7219
    ldi r16, (1<<DDB2) | (1<<DDB3) | (1<<DDB5)
    out DDRB, r16
    ldi r16, (1<<PB2)
    out PORTB, r16

  

    ; D2 e D3 como entradas con pull-up interno.
    clr r16
    out DDRD, r16
    ldi r16, (1<<PD2) | (1<<PD3)
    out PORTD, r16


    clr r16
    sts imagen_actual, r16
    ldi r16, 1
    sts actualizar_matriz, r16

    ; SPI maestro, modo 0, MSB primero, F_CPU/16 = 1 MHz.
    ldi r16, (1<<SPE) | (1<<MSTR) | (1<<SPR0)
    out SPCR, r16
    clr r16
    out SPSR, r16





    ; CS inactivo en uno.
    ldi r16, (1<<PB2)
    out PORTB, r16



    rcall INICIALIZAR_MAX7219

PRINCIPAL:
    lds r16, actualizar_matriz
    tst r16
    breq PRINCIPAL
    clr r16
    sts actualizar_matriz, r16
    rcall MOSTRAR_IMAGEN
    rjmp PRINCIPAL

; D2: 0->1->2->3->4->5->0.
ISR_INT0:
    push r16
    in   r16, SREG
    push r16
    push r17

    lds r17, imagen_actual
    inc r17
    cpi r17, 6
    brlo INT0_GUARDAR
    clr r17

INT0_GUARDAR:
    sts imagen_actual, r17
    ldi r17, 1
    sts actualizar_matriz, r17
    rjmp ISR_FIN

; D3: recorrido inverso.
ISR_INT1:
    push r16
    in   r16, SREG
    push r16
    push r17

    lds r17, imagen_actual
    tst r17
    breq INT1_ENVOLVER
    dec r17
    rjmp INT1_GUARDAR

INT1_ENVOLVER:
    ldi r17, 5

INT1_GUARDAR:
    sts imagen_actual, r17
    ldi r17, 1
    sts actualizar_matriz, r17

ISR_FIN:
    pop r17
    pop r16
    out SREG, r16
    pop r16
    reti


; Configura el MAX7219 para controlar las ocho filas de la matriz.
INICIALIZAR_MAX7219:
    ldi r16, MAX_DISPLAY_TEST
    clr r17
    rcall MAX_ESCRIBIR

    ldi r16, MAX_SHUTDOWN
    clr r17
    rcall MAX_ESCRIBIR

    ldi r16, MAX_DECODE_MODE
    clr r17
    rcall MAX_ESCRIBIR

    ldi r16, MAX_SCAN_LIMIT
    ldi r17, 7
    rcall MAX_ESCRIBIR

    ldi r16, MAX_INTENSITY
    ldi r17, INTENSIDAD_MATRIZ
    rcall MAX_ESCRIBIR

    ; Limpiar las ocho filas.
    ldi r19, 1
    clr r17

MAX_LIMPIAR:
    mov r16, r19
    rcall MAX_ESCRIBIR
    inc r19
    cpi r19, 9
    brlo MAX_LIMPIAR

    ; Encender el MAX7219 en modo normal.
    ldi r16, MAX_SHUTDOWN
    ldi r17, 1
    rcall MAX_ESCRIBIR
    ret

; Envia una trama de 16 bits: r16=direccion y r17=dato.
MAX_ESCRIBIR:
    cbi PORTB, PB2
    rcall SPI_ENVIAR
    mov r16, r17
    rcall SPI_ENVIAR
    sbi PORTB, PB2
    ret

; Envia por SPI el byte contenido en r16.
SPI_ENVIAR:
    out SPDR, r16

SPI_ESPERAR:
    in   r18, SPSR
    sbrs r18, SPIF
    rjmp SPI_ESPERAR
    in   r18, SPDR
    ret
MOSTRAR_IMAGEN:
    push r16
    push r17
    push r18
    push r19
    push r30
    push r31

    ldi r30, low(TABLA_IMAGENES*2)
    ldi r31, high(TABLA_IMAGENES*2)
    clr r18

    lds r16, imagen_actual
    lsl r16
    lsl r16
    lsl r16
    add r30, r16
    adc r31, r18

    ldi r19, 1
MOSTRAR_FILA:
    lpm r17, Z+
    mov r16, r19
    rcall MAX_ESCRIBIR
    inc r19
    cpi r19, 9
    brlo MOSTRAR_FILA

    pop r31
    pop r30
    pop r19
    pop r18
    pop r17
    pop r16
    ret

TABLA_IMAGENES:

; 0: carita sonriendo
    .db 0b00111100, 0b01000010, 0b10100101, 0b10000001
    .db 0b10100001, 0b10011101, 0b01000010, 0b00111100
; 1: carita guinando.
    .db 0b00111100,0b01000010,0b10100001,0b10001101
    .db 0b10100001,0b10011101,0b01000010,0b00111100
; 2: corazon.
    .db 0b00000000,0b01100110,0b11111111,0b11111111
    .db 0b01111110,0b00111100,0b00011000,0b00000000
; 3: :3.
    .db 0b00000000,0b00011100,0b01000010,0b00011100
    .db 0b01000010,0b00011100,0b00000000,0b00000000
; 4: estrella.
    .db 0b00011000,0b00011000,0b00111100,0b11111111
    .db 0b01111110,0b00111100,0b01100110,0b01000010
; 5: XD.
    .db 0b00000000,0b10101110,0b10101001,0b01001001
    .db 0b10101001,0b10101110,0b00000000,0b00000000




