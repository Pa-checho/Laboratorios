.include "m328pdef.inc"

.equ VELOCIDAD_SCROLL_MS = 150
.equ INTENSIDAD_MATRIZ = 3
.equ MENSAJE_TOTAL_COLUMNAS = 148
.equ MENSAJE_POSICIONES     = MENSAJE_TOTAL_COLUMNAS-7

.equ MAX_DECODE_MODE   = 0x09
.equ MAX_INTENSITY     = 0x0A
.equ MAX_SCAN_LIMIT    = 0x0B
.equ MAX_SHUTDOWN      = 0x0C
.equ MAX_DISPLAY_TEST  = 0x0F

.dseg
modo_actual:        .byte 1
desplazamiento:     .byte 1
tiempo_scroll_L:    .byte 1
tiempo_scroll_H:    .byte 1
actualizar_matriz:  .byte 1



.cseg
.org 0x0000
    rjmp RESET
.org INT0addr
    rjmp ISR_INT0
.org INT1addr
    rjmp ISR_INT1
.org OC0Aaddr
    rjmp ISR_TIMER0_COMPA
.org INT_VECTORS_SIZE

RESET:
    cli

    ; Inicializar la pila para poder utilizar RCALL y RET.
    ldi r16, high(RAMEND)
    out SPH, r16
    ldi r16, low(RAMEND)
    out SPL, r16

    ; SPI hacia MAX7219
    ldi r16, (1<<DDB2) | (1<<DDB3) | (1<<DDB5)
    out DDRB, r16
    ldi r16, (1<<PB2)
    out PORTB, r16

  

    ; D2 e D3 como entradas con pull-up interno.
    clr r16
    out DDRD, r16
    ldi r16, (1<<PD2) | (1<<PD3)
    out PORTD, r16


    clr r16
    sts modo_actual, r16
    sts desplazamiento, r16
    ldi r16, low(VELOCIDAD_SCROLL_MS)
    sts tiempo_scroll_L, r16
    ldi r16, high(VELOCIDAD_SCROLL_MS)
    sts tiempo_scroll_H, r16
    ldi r16, 1
    sts actualizar_matriz, r16

    ; SPI maestro, modo 0, MSB primero, F_CPU/16 = 1 MHz.
    ldi r16, (1<<SPE) | (1<<MSTR) | (1<<SPR0)
    out SPCR, r16
    clr r16
    out SPSR, r16

    rcall INICIALIZAR_MAX7219
    rcall INICIALIZAR_USART

    ; Interrupciones externas por flanco de bajada.
    ldi r16, (1<<ISC01) | (1<<ISC11)
    sts EICRA, r16
    ldi r16, (1<<INTF0) | (1<<INTF1)
    out EIFR, r16
    ldi r16, (1<<INT0) | (1<<INT1)
    out EIMSK, r16

    ; Timer0 CTC: 16 MHz/(64*(249+1)) = un tick cada 1 ms.
    ldi r16, (1<<WGM01)
    out TCCR0A, r16
    ldi r16, 249
    out OCR0A, r16
    clr r16
    out TCNT0, r16
    ldi r16, (1<<OCF0A)
    out TIFR0, r16
    ldi r16, (1<<OCIE0A)
    sts TIMSK0, r16
    ldi r16, (1<<CS01) | (1<<CS00)
    out TCCR0B, r16
    sei

    ldi r30, low(TEXTO_BIENVENIDA*2)
    ldi r31, high(TEXTO_BIENVENIDA*2)
    rcall USART_ENVIAR_CADENA
    rcall USART_MOSTRAR_MENU


PRINCIPAL:
    rcall USART_REVISAR_ENTRADA
    lds r16, actualizar_matriz
    tst r16
    breq PRINCIPAL
    clr r16
    sts actualizar_matriz, r16
    rcall MOSTRAR_SELECCION
    rjmp PRINCIPAL

; 
ISR_INT0:
    push r16
    in   r16, SREG
    push r16
    push r17

    lds r17, modo_actual
    inc r17
    cpi r17, 7
    brlo INT0_GUARDAR
    clr r17

INT0_GUARDAR:
    sts modo_actual, r17
    rjmp REINICIAR_SELECCION

; D3: recorrido inverso.


ISR_INT1:
    push r16
    in   r16, SREG
    push r16
    push r17

    lds r17, modo_actual
    tst r17
    breq INT1_ENVOLVER
    dec r17
    rjmp INT1_GUARDAR

INT1_ENVOLVER:
    ldi r17, 6

INT1_GUARDAR:
    sts modo_actual, r17

REINICIAR_SELECCION:
    clr r17
    sts desplazamiento, r17
    ldi r17, low(VELOCIDAD_SCROLL_MS)
    sts tiempo_scroll_L, r17
    ldi r17, high(VELOCIDAD_SCROLL_MS)
    sts tiempo_scroll_H, r17
    ldi r17, 1
    sts actualizar_matriz, r17
    pop r17
    pop r16
    out SREG, r16
    pop r16
    reti

; Cada 150 ticks de 1 ms, avanzar una columna si el modo es el mensaje.
ISR_TIMER0_COMPA:
    push r16
    in r16, SREG
    push r16
    push r17

    lds r16, modo_actual
    tst r16
    brne TIMER0_FIN

    lds r16, tiempo_scroll_L
    lds r17, tiempo_scroll_H
    subi r16, 1
    sbci r17, 0
    sts tiempo_scroll_L, r16
    sts tiempo_scroll_H, r17

    tst r16
    brne TIMER0_FIN
    tst r17
    brne TIMER0_FIN

    lds r16, desplazamiento
    inc r16
    cpi r16, MENSAJE_POSICIONES
    brlo TIMER0_GUARDAR
    clr r16

TIMER0_GUARDAR:
    sts desplazamiento, r16
    ldi r16, 1
    sts actualizar_matriz, r16
    ldi r16, low(VELOCIDAD_SCROLL_MS)
    sts tiempo_scroll_L, r16
    ldi r16, high(VELOCIDAD_SCROLL_MS)
    sts tiempo_scroll_H, r16

TIMER0_FIN:
    pop r17
    pop r16
    out SREG, r16
    pop r16
    reti

USART_REVISAR_ENTRADA:
    lds  r17, UCSR0A
    sbrs r17, RXC0
    ret

    lds  r16, UDR0

    cpi  r16, 'M'
    breq USART_PEDIR_MENU
    cpi  r16, 'm'
    breq USART_PEDIR_MENU

    ; CR y LF se ignoran para que la tecla Enter no produzca un error.
    cpi  r16, 13
    breq USART_ENTRADA_FIN
    cpi  r16, 10
    breq USART_ENTRADA_FIN

    cpi  r16, '1'
    brlo USART_ENTRADA_INVALIDA
    cpi  r16, '8'
    brsh USART_ENTRADA_INVALIDA

    ; Convertir ASCII '1'..'7' en modo interno 0..6.
    subi r16, '1'
    rcall SELECCIONAR_MODO

    ldi  r30, low(TEXTO_OK*2)
    ldi  r31, high(TEXTO_OK*2)
    rcall USART_ENVIAR_CADENA
    ret

USART_PEDIR_MENU:
    rcall USART_MOSTRAR_MENU
    ret

USART_ENTRADA_INVALIDA:
    ldi  r30, low(TEXTO_ERROR*2)
    ldi  r31, high(TEXTO_ERROR*2)
    rcall USART_ENVIAR_CADENA

USART_ENTRADA_FIN:
    ret

; r16 recibe el nuevo modo. Se reinician el scroll y la bandera de pantalla.
SELECCIONAR_MODO:
    cli
    sts  modo_actual, r16
    clr  r17
    sts  desplazamiento, r17
    ldi  r17, low(VELOCIDAD_SCROLL_MS)
    sts  tiempo_scroll_L, r17
    ldi  r17, high(VELOCIDAD_SCROLL_MS)
    sts  tiempo_scroll_H, r17
    ldi  r17, 1
    sts  actualizar_matriz, r17
    sei
    ret

;---------------------------- USART -------------------------------------------
; 16 MHz, modo normal: UBRR0=103 produce aproximadamente 9600 baudios.
INICIALIZAR_USART:
    clr r16
    sts UCSR0A, r16
    sts UBRR0H, r16
    ldi r16, 103
    sts UBRR0L, r16

    ; Habilitar receptor y transmisor; no se usa interrupcion de recepcion.
    ldi r16, (1<<RXEN0) | (1<<TXEN0)
    sts UCSR0B, r16

    ; 8 bits de datos, sin paridad y un bit de parada (8N1).
    ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
    sts UCSR0C, r16
    ret

; Envia por UART el byte que llega en r16.
USART_ENVIAR_BYTE:
    lds  r17, UCSR0A
    sbrs r17, UDRE0
    rjmp USART_ENVIAR_BYTE
    sts  UDR0, r16
    ret

; Envia una cadena terminada en cero desde la memoria de programa apuntada por Z.
USART_ENVIAR_CADENA:
    lpm  r16, Z+
    tst  r16
    breq USART_CADENA_FIN
    rcall USART_ENVIAR_BYTE
    rjmp USART_ENVIAR_CADENA

USART_CADENA_FIN:
    ret

; Imprime el menu por lineas. Separar las cadenas simplifica su edicion.
USART_MOSTRAR_MENU:
    ldi r30, low(TEXTO_MENU_1*2)
    ldi r31, high(TEXTO_MENU_1*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_2*2)
    ldi r31, high(TEXTO_MENU_2*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_3*2)
    ldi r31, high(TEXTO_MENU_3*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_4*2)
    ldi r31, high(TEXTO_MENU_4*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_5*2)
    ldi r31, high(TEXTO_MENU_5*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_6*2)
    ldi r31, high(TEXTO_MENU_6*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_7*2)
    ldi r31, high(TEXTO_MENU_7*2)
    rcall USART_ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_FIN*2)
    ldi r31, high(TEXTO_MENU_FIN*2)
    rcall USART_ENVIAR_CADENA
    ret





; Configura el MAX7219 para controlar las ocho filas de la matriz.
INICIALIZAR_MAX7219:
    ldi r16, MAX_DISPLAY_TEST
    clr r17
    rcall MAX_ESCRIBIR

    ldi r16, MAX_SHUTDOWN
    clr r17
    rcall MAX_ESCRIBIR

    ldi r16, MAX_DECODE_MODE
    clr r17
    rcall MAX_ESCRIBIR

    ldi r16, MAX_SCAN_LIMIT
    ldi r17, 7
    rcall MAX_ESCRIBIR

    ldi r16, MAX_INTENSITY
    ldi r17, INTENSIDAD_MATRIZ
    rcall MAX_ESCRIBIR

    ; Limpiar las ocho filas.
    ldi r19, 1
    clr r17

MAX_LIMPIAR:
    mov r16, r19
    rcall MAX_ESCRIBIR
    inc r19
    cpi r19, 9
    brlo MAX_LIMPIAR
    ldi r16, MAX_SHUTDOWN
    ldi r17, 1
    rcall MAX_ESCRIBIR
    ret

; Envia una trama de 16 bits: r16=direccion y r17=dato.
MAX_ESCRIBIR:
    cbi PORTB, PB2
    rcall SPI_ENVIAR
    mov r16, r17
    rcall SPI_ENVIAR
    sbi PORTB, PB2
    ret

; Envia por SPI el byte contenido en r16.
SPI_ENVIAR:
    out SPDR, r16

SPI_ESPERAR:
    in   r18, SPSR
    sbrs r18, SPIF
    rjmp SPI_ESPERAR
    in   r18, SPDR
    ret

MOSTRAR_SELECCION:
    lds r16, modo_actual
    tst r16
    breq MOSTRAR_MENSAJE
    rcall MOSTRAR_IMAGEN
    ret
MOSTRAR_MENSAJE:
    rcall MOSTRAR_CUADRO_MENSAJE
    ret

MOSTRAR_IMAGEN:
    push r16
    push r17
    push r18
    push r19
    push r30
    push r31

    ldi r30, low(TABLA_IMAGENES*2)
    ldi r31, high(TABLA_IMAGENES*2)
    clr r18

    lds r16, modo_actual
    dec r16
    lsl r16
    lsl r16
    lsl r16
    add r30, r16
    adc r31, r18

    ldi r19, 1
IMAGEN_SIGUIENTE_FILA:
    lpm r17, Z+
    mov r16, r19
    rcall MAX_ESCRIBIR
    inc r19
    cpi r19, 9
    brlo IMAGEN_SIGUIENTE_FILA

    pop r31
    pop r30
    pop r19
    pop r18
    pop r17
    pop r16
    ret
MOSTRAR_CUADRO_MENSAJE:
    push r16
    push r17
    push r18
    push r19
    push r20
    push r21
    push r22
    push r23
    push r24
    push r25
    push r30
    push r31

    ldi r19, 1
    ldi r20, 0x01
MENSAJE_FILAS:
    ldi r30, low(MENSAJE_COLUMNAS*2)
    ldi r31, high(MENSAJE_COLUMNAS*2)
    lds r24, desplazamiento
    clr r25
    add r30, r24
    adc r31, r25

    clr r21
    ldi r22, 8
MENSAJE_COLUMNAS_VISIBLES:
    lsl r21
    lpm r23, Z+
    and r23, r20
    breq MENSAJE_LED_APAGADO
    ori r21, 1
MENSAJE_LED_APAGADO:
    dec r22
    brne MENSAJE_COLUMNAS_VISIBLES

    mov r16, r19
    mov r17, r21
    rcall MAX_ESCRIBIR
    inc r19
    lsl r20
    cpi r19, 9
    brlo MENSAJE_FILAS

    pop r31
    pop r30
    pop r25
    pop r24
    pop r23
    pop r22
    pop r21
    pop r20
    pop r19
    pop r18
    pop r17
    pop r16
    ret

TEXTO_BIENVENIDA:
    .db 13,10,"=== LABORATORIO 2 - PROBLEMA A ===",13,10,"Matriz FC16/MAX7219 - UART 9600 8N1",13,10,0
TEXTO_MENU_1:
    .db 13,10,"1 - Mensaje: VIAJE ANTES QUE DESTINO",13,10,0,0
TEXTO_MENU_2:
    .db "2 - Carita sonriendo",13,10,0,0
TEXTO_MENU_3:
    .db "3 - Carita guinando",13,10,0
TEXTO_MENU_4:
    .db "4 - Corazon",13,10,0
TEXTO_MENU_5:
    .db "5 - :3",13,10,0,0
TEXTO_MENU_6:
    .db "6 - Asterisco",13,10,0
TEXTO_MENU_7:
    .db "7 - XD",13,10,0,0
TEXTO_MENU_FIN:
    .db "M - Repetir menu",13,10,"> ",0,0
TEXTO_OK:
    .db 13,10,"Opcion aplicada. Ingrese 1..7 o M.",13,10,"> ",0,0
TEXTO_ERROR:
    .db 13,10,"Entrada invalida. Ingrese 1..7 o M.",13,10,"> ",0
MENSAJE_COLUMNAS:
    ; Ocho columnas vacías para que el mensaje entre desde la derecha.
    .db 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00

    ; V I A J E
    .db 0x1F,0x20,0x40,0x20,0x1F,0x00
    .db 0x00,0x41,0x7F,0x41,0x00,0x00
    .db 0x7E,0x11,0x11,0x11,0x7E,0x00
    .db 0x20,0x40,0x41,0x3F,0x01,0x00
    .db 0x7F,0x49,0x49,0x49,0x41,0x00

    .db 0x00,0x00,0x00,0x00

    ; A N T E S
    .db 0x7E,0x11,0x11,0x11,0x7E,0x00
    .db 0x7F,0x02,0x04,0x08,0x7F,0x00
    .db 0x01,0x01,0x7F,0x01,0x01,0x00
    .db 0x7F,0x49,0x49,0x49,0x41,0x00
    .db 0x46,0x49,0x49,0x49,0x31,0x00

    .db 0x00,0x00,0x00,0x00

    ; Q U E
    .db 0x3E,0x41,0x51,0x21,0x5E,0x00
    .db 0x3F,0x40,0x40,0x40,0x3F,0x00
    .db 0x7F,0x49,0x49,0x49,0x41,0x00

    .db 0x00,0x00,0x00,0x00

    ; D E S T I N O
    .db 0x7F,0x41,0x41,0x22,0x1C,0x00
    .db 0x7F,0x49,0x49,0x49,0x41,0x00
    .db 0x46,0x49,0x49,0x49,0x31,0x00
    .db 0x01,0x01,0x7F,0x01,0x01,0x00
    .db 0x00,0x41,0x7F,0x41,0x00,0x00
    .db 0x7F,0x02,0x04,0x08,0x7F,0x00
    .db 0x3E,0x41,0x41,0x41,0x3E,0x00

    ; Ocho columnas vacías finales.
    .db 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00

TABLA_IMAGENES:

; 0: carita sonriendo
    .db 0b00111100, 0b01000010, 0b10100101, 0b10000001
    .db 0b10100001, 0b10011101, 0b01000010, 0b00111100
; 1: carita guinando.
    .db 0b00111100,0b01000010,0b10100001,0b10001101
    .db 0b10100001,0b10011101,0b01000010,0b00111100
; 2: corazon.
    .db 0b00000000,0b01100110,0b11111111,0b11111111
    .db 0b01111110,0b00111100,0b00011000,0b00000000
; 3: :3.
    .db 0b00000000,0b00011100,0b01000010,0b00011100
    .db 0b01000010,0b00011100,0b00000000,0b00000000
; 4: estrella.
    .db 0b00011000,0b00011000,0b00111100,0b11111111
    .db 0b01111110,0b00111100,0b01100110,0b01000010
; 5: XD.
    .db 0b00000000,0b10101110,0b10101001,0b01001001
    .db 0b10101001,0b10101110,0b00000000,0b00000000




