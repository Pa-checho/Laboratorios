.include "m328pdef.inc"

; CONSTANTES
.equ F_CPU = 16000000
.equ BAUD = 9600
.equ UBRR_VAL = 103

.cseg                         ;Comienza el codigo
.org 0x0000                   ;direccion de memoria
    rjmp INICIO

INICIO:
    ;Configurar pines del DAC
    ldi r16, 0b11111100
    out DDRD, r16                  ;PD2 - PD7 como salida

    ldi r16, 0b00000011
    out DDRB, r16                 ;PB0 - PB1 salidas

    ;Apagar salidas
    clr r16
    out PORTD, r16
    out PORTB, r16

    ; Configurar USART
    ldi r16, HIGH(UBRR_VAL)
    sts UBRR0H, r16

    ldi r16, LOW(UBRR_VAL)
    sts UBRR0L, r16

    ldi r16, (1<<RXEN0)
    sts UCSR0B, r16

    ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
    sts UCSR0C, r16

    ldi r16, (1<<WGM01)
    out TCCR0A, r16

    ;Prescaler 64
    ldi r16, (1<<CS01) | (1<<CS00)
    out TCCR0B, r16

    ; 1 kHz
    ldi r16, 249
    out OCR0A, r16

    rjmp CARGA_S1

BUCLE_PRINCIPAL:

    ; Revisar bandera del Timer
    in r16, TIFR0
    sbrs r16, OCF0A
    rjmp REVISAR_SERIAL

    ; Limpiar bandera
    ldi r16, (1<<OCF0A)
    out TIFR0, r16

    ; Leer muestra
    lpm r16, Z+

    ; Bits 0-5 hacia PORTD
    mov r18, r16
    lsl r18
    lsl r18
    out PORTD, r18

    ; Bits 6-7 hacia PORTB
    mov r19, r16
    lsr r19
    lsr r19
    lsr r19
    lsr r19
    lsr r19
    lsr r19
    out PORTB, r19

    ; Contador de muestras
    dec r20
    brne REVISAR_SERIAL

    cpi r21, 1
    breq RECARGAR_1

    rjmp RECARGAR_9

REVISAR_SERIAL:

    ; Revisar USART
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp BUCLE_PRINCIPAL

    ; Leer dato
    lds r16, UDR0

    ; Seleccionar señal
    cpi r16, '1'
    breq CARGAR_S1

    cpi r16, '9'
    breq CARGAR_S9

    ; Ignorar otros datos
    rjmp BUCLE_PRINCIPA


RECARGAR_1:
    ldi ZL, LOW(SENAL_1 * 2)
    ldi ZH, HIGH(SENAL_1 * 2)
    ldi r20, 0
    ldi r21, 1

    rjmp BUCLE

RECARGAR_9:
    ldi ZL, LOW(SENAL_9 * 2)
    ldi ZH, HIGH(SENAL_9 * 2)
    ldi r20, 32
    ldi r21, 9
    rjmp BUCLE   


SERIAL:
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp BUCLE

    lds r16, UDR0

    cpi r16, '1'
    breq RECARGAR_1

    cpi r16, '9'
    breq RECARGAR_9

    rjmp BUCLE


SENAL_9:
