; Laboratorio 2 - Problema C: Plotter
; Version final: figuras geometricas y Magnemite

.include "m328pdef.inc"

; Pines conectados al PLC
.equ CMD_BAJAR_LAPIZ = (1<<PD2)
.equ CMD_SUBIR_LAPIZ = (1<<PD3)
.equ CMD_ABAJO       = (1<<PD4)
.equ CMD_ARRIBA      = (1<<PD5)
.equ CMD_DERECHA     = (1<<PD6)
.equ CMD_IZQUIERDA   = (1<<PD7)

.equ MASCARA_PLOTTER = (1<<PD2) | (1<<PD3) | (1<<PD4) | (1<<PD5) | (1<<PD6) | (1<<PD7)
.equ PASO_MS         = 100
.equ PASO_DDA_MS     = 20
.equ SUBPASOS_DDA    = 5
.equ PULSO_LAPIZ_MS  = 500

; Codigos que se guardan en las tablas de las figuras
.equ OP_FIN          = 0
.equ OP_LINEA        = 1
.equ OP_LAPIZ_ARRIBA = 2
.equ OP_LAPIZ_ABAJO  = 3

; Variables que usa el temporizador
.dseg
tiempo_restante_L: .byte 1
tiempo_restante_H: .byte 1
salida_activa:      .byte 1
dibujo_abortado:    .byte 1

.cseg

.org 0x0000
    rjmp RESET

.org OC0Aaddr
    rjmp ISR_TIMER0_COMPA

.org INT_VECTORS_SIZE

RESET:
    cli

    ; Inicializo la pila
    ldi r16, high(RAMEND)
    out SPH, r16
    ldi r16, low(RAMEND)
    out SPL, r16

    ; D2 hasta D7 son salidas para la maquina
    clr r16
    out PORTD, r16
    ldi r16, MASCARA_PLOTTER
    out DDRD, r16

    clr r16
    sts tiempo_restante_L, r16
    sts tiempo_restante_H, r16
    sts salida_activa, r16
    sts dibujo_abortado, r16

    rcall INICIALIZAR_USART
    rcall INICIALIZAR_TIMER0
    sei

    rcall MOSTRAR_MENU

PRINCIPAL:
    rcall REVISAR_USART
    rjmp PRINCIPAL

; El Timer0 interrumpe cada 1 ms
INICIALIZAR_TIMER0:
    ldi r16, (1<<WGM01)
    out TCCR0A, r16
    ldi r16, 249
    out OCR0A, r16
    clr r16
    out TCNT0, r16
    ldi r16, (1<<OCF0A)
    out TIFR0, r16
    ldi r16, (1<<OCIE0A)
    sts TIMSK0, r16
    ldi r16, (1<<CS01) | (1<<CS00)
    out TCCR0B, r16
    ret

ISR_TIMER0_COMPA:
    push r16
    in r16, SREG
    push r16
    push r17

    lds r16, salida_activa
    tst r16
    breq TIMER_FIN

    ; Resto un milisegundo al tiempo del pulso
    lds r16, tiempo_restante_L
    lds r17, tiempo_restante_H
    subi r16, 1
    sbci r17, 0
    sts tiempo_restante_L, r16
    sts tiempo_restante_H, r17

    or r16, r17
    brne TIMER_FIN

    ; Cuando llega a cero apago todas las ordenes
    clr r16
    out PORTD, r16
    sts salida_activa, r16

TIMER_FIN:
    pop r17
    pop r16
    out SREG, r16
    pop r16
    reti

; r16 tiene la salida y r25:r24 el tiempo en ms
INICIAR_PULSO:
    cli
    sts tiempo_restante_L, r24
    sts tiempo_restante_H, r25
    ldi r18, 1
    sts salida_activa, r18
    andi r16, MASCARA_PLOTTER
    out PORTD, r16
    sei
    ret

; Espero hasta que el Timer0 termine el movimiento
PULSO_ESPERAR:
    rcall INICIAR_PULSO

ESPERAR_PULSO:
    lds r18, salida_activa
    tst r18
    breq FIN_PULSO

    ; Mientras dibuja se puede mandar X para parar
    lds r18, UCSR0A
    sbrs r18, RXC0
    rjmp ESPERAR_PULSO

    lds r18, UDR0
    cpi r18, 'X'
    breq ABORTAR_PULSO
    cpi r18, 'x'
    brne ESPERAR_PULSO

ABORTAR_PULSO:
    rcall DETENER_PLOTTER
    ldi r18, 1
    sts dibujo_abortado, r18

FIN_PULSO:
    ret

DETENER_PLOTTER:
    cli
    clr r16
    out PORTD, r16
    sts tiempo_restante_L, r16
    sts tiempo_restante_H, r16
    sts salida_activa, r16
    sei
    ret

; r20 es el movimiento en X y r21 es el movimiento en Y
; Los numeros positivos van a izquierda y abajo
MOVER_LINEA_DDA:
    clr r22
    sbrs r20, 7
    rjmp X_POSITIVO
    neg r20
    ldi r22, CMD_DERECHA
    rjmp X_LISTO

X_POSITIVO:
    tst r20
    breq X_LISTO
    ldi r22, CMD_IZQUIERDA

X_LISTO:
    clr r23
    sbrs r21, 7
    rjmp Y_POSITIVO
    neg r21
    ldi r23, CMD_ARRIBA
    rjmp Y_LISTO

Y_POSITIVO:
    tst r21
    breq Y_LISTO
    ldi r23, CMD_ABAJO

Y_LISTO:
    ; Tomo el desplazamiento mas grande como cantidad de pasos
    mov r26, r20
    cp r26, r21
    brsh MAX_LISTO
    mov r26, r21

MAX_LISTO:
    tst r26
    brne HAY_MOVIMIENTO
    ret

HAY_MOVIMIENTO:
    ; Las horizontales, verticales y diagonales iguales se hacen sin cortes
    tst r20
    breq MOVIMIENTO_CONTINUO
    tst r21
    breq MOVIMIENTO_CONTINUO
    cp r20, r21
    brne PREPARAR_DDA

MOVIMIENTO_CONTINUO:
    ldi r18, PASO_MS
    mul r26, r18
    movw r24, r0
    clr r1

    mov r16, r22
    or r16, r23
    rcall PULSO_ESPERAR
    ret

PREPARAR_DDA:
    ; Para las otras pendientes uso cinco pulsos de 20 ms por cada paso
    push r14
    push r15
    ldi r18, SUBPASOS_DDA
    mul r26, r18
    mov r14, r0
    mov r15, r1
    clr r1
    clr r28
    clr r29

BUCLE_DDA:
    clr r16

    add r28, r20
    cp r28, r26
    brlo SIN_MOVIMIENTO_X
    sub r28, r26
    or r16, r22

SIN_MOVIMIENTO_X:
    add r29, r21
    cp r29, r26
    brlo SIN_MOVIMIENTO_Y
    sub r29, r26
    or r16, r23

SIN_MOVIMIENTO_Y:
    ldi r24, low(PASO_DDA_MS)
    ldi r25, high(PASO_DDA_MS)
    rcall PULSO_ESPERAR

    lds r18, dibujo_abortado
    tst r18
    brne FIN_DDA

    ldi r18, 1
    sub r14, r18
    clr r18
    sbc r15, r18
    mov r18, r14
    or r18, r15
    brne BUCLE_DDA

FIN_DDA:
    pop r15
    pop r14
    ret

; Cada orden de la tabla ocupa cuatro bytes
EJECUTAR_TABLA:
    clr r18
    sts dibujo_abortado, r18

SIGUIENTE_ORDEN:
    lpm r16, Z+
    lpm r20, Z+
    lpm r21, Z+
    adiw r30, 1

    cpi r16, OP_FIN
    breq FIN_TABLA
    cpi r16, OP_LINEA
    breq ORDEN_LINEA
    cpi r16, OP_LAPIZ_ARRIBA
    breq ORDEN_SUBIR
    cpi r16, OP_LAPIZ_ABAJO
    breq ORDEN_BAJAR
    rjmp SIGUIENTE_ORDEN

ORDEN_LINEA:
    rcall MOVER_LINEA_DDA
    rjmp COMPROBAR_ABORTO

ORDEN_SUBIR:
    ldi r16, CMD_SUBIR_LAPIZ
    rjmp ORDEN_LAPIZ

ORDEN_BAJAR:
    ldi r16, CMD_BAJAR_LAPIZ

ORDEN_LAPIZ:
    ldi r24, low(PULSO_LAPIZ_MS)
    ldi r25, high(PULSO_LAPIZ_MS)
    rcall PULSO_ESPERAR

COMPROBAR_ABORTO:
    lds r18, dibujo_abortado
    tst r18
    brne FIN_TABLA
    rjmp SIGUIENTE_ORDEN

FIN_TABLA:
    ret

; Configuracion serie: 9600 baudios, 8 bits, sin paridad y 1 bit de parada
INICIALIZAR_USART:
    clr r16
    sts UCSR0A, r16
    sts UBRR0H, r16
    ldi r16, 103
    sts UBRR0L, r16

    ldi r16, (1<<RXEN0) | (1<<TXEN0)
    sts UCSR0B, r16
    ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
    sts UCSR0C, r16
    ret

REVISAR_USART:
    lds r17, UCSR0A
    sbrs r17, RXC0
    ret

    lds r16, UDR0

    cpi r16, '1'
    brne PROBAR_2
    rjmp DIBUJAR_TRIANGULO

PROBAR_2:
    cpi r16, '2'
    brne PROBAR_3
    rjmp DIBUJAR_CIRCULO

PROBAR_3:
    cpi r16, '3'
    brne PROBAR_4
    rjmp DIBUJAR_PENTAGRAMA

PROBAR_4:
    cpi r16, '4'
    brne PROBAR_P
    rjmp DIBUJAR_CUADRADO

PROBAR_P:
    cpi r16, 'P'
    brne PROBAR_P_MINUSCULA
    rjmp DIBUJAR_MAGNEMITE

PROBAR_P_MINUSCULA:
    cpi r16, 'p'
    brne PROBAR_T
    rjmp DIBUJAR_MAGNEMITE

PROBAR_T:
    cpi r16, 'T'
    brne PROBAR_T_MINUSCULA
    rjmp DIBUJAR_TODAS

PROBAR_T_MINUSCULA:
    cpi r16, 't'
    brne PROBAR_M
    rjmp DIBUJAR_TODAS

PROBAR_M:
    cpi r16, 'M'
    brne PROBAR_M_MINUSCULA
    rjmp VOLVER_A_MOSTRAR_MENU

PROBAR_M_MINUSCULA:
    cpi r16, 'm'
    brne PROBAR_X
    rjmp VOLVER_A_MOSTRAR_MENU

PROBAR_X:
    cpi r16, 'X'
    brne PROBAR_X_MINUSCULA
    rjmp PARAR

PROBAR_X_MINUSCULA:
    cpi r16, 'x'
    brne PROBAR_FIN_LINEA
    rjmp PARAR

PROBAR_FIN_LINEA:
    cpi r16, 13
    breq FIN_ENTRADA
    cpi r16, 10
    breq FIN_ENTRADA

    ldi r30, low(TEXTO_ERROR*2)
    ldi r31, high(TEXTO_ERROR*2)
    rcall ENVIAR_CADENA

FIN_ENTRADA:
    ret

DIBUJAR_TRIANGULO:
    ldi r30, low(TEXTO_TRIANGULO*2)
    ldi r31, high(TEXTO_TRIANGULO*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TABLA_TRIANGULO*2)
    ldi r31, high(TABLA_TRIANGULO*2)
    rjmp EJECUTAR_DIBUJO

DIBUJAR_CIRCULO:
    ldi r30, low(TEXTO_CIRCULO*2)
    ldi r31, high(TEXTO_CIRCULO*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TABLA_CIRCULO*2)
    ldi r31, high(TABLA_CIRCULO*2)
    rjmp EJECUTAR_DIBUJO

DIBUJAR_PENTAGRAMA:
    ldi r30, low(TEXTO_PENTAGRAMA*2)
    ldi r31, high(TEXTO_PENTAGRAMA*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TABLA_PENTAGRAMA*2)
    ldi r31, high(TABLA_PENTAGRAMA*2)
    rjmp EJECUTAR_DIBUJO

DIBUJAR_CUADRADO:
    ldi r30, low(TEXTO_CUADRADO*2)
    ldi r31, high(TEXTO_CUADRADO*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TABLA_CUADRADO*2)
    ldi r31, high(TABLA_CUADRADO*2)
    rjmp EJECUTAR_DIBUJO

DIBUJAR_MAGNEMITE:
    ldi r30, low(TEXTO_MAGNEMITE*2)
    ldi r31, high(TEXTO_MAGNEMITE*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TABLA_MAGNEMITE*2)
    ldi r31, high(TABLA_MAGNEMITE*2)
    rjmp EJECUTAR_DIBUJO

DIBUJAR_TODAS:
    ldi r30, low(TEXTO_TODAS*2)
    ldi r31, high(TEXTO_TODAS*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TABLA_TODAS*2)
    ldi r31, high(TABLA_TODAS*2)

EJECUTAR_DIBUJO:
    rcall EJECUTAR_TABLA

    lds r18, dibujo_abortado
    tst r18
    brne MOSTRAR_ABORTADO

    ldi r30, low(TEXTO_TERMINADO*2)
    ldi r31, high(TEXTO_TERMINADO*2)
    rcall ENVIAR_CADENA
    rcall MOSTRAR_MENU
    ret

MOSTRAR_ABORTADO:
    ldi r30, low(TEXTO_ABORTADO*2)
    ldi r31, high(TEXTO_ABORTADO*2)
    rcall ENVIAR_CADENA
    rcall MOSTRAR_MENU
    ret

PARAR:
    rcall DETENER_PLOTTER
    ldi r30, low(TEXTO_DETENIDO*2)
    ldi r31, high(TEXTO_DETENIDO*2)
    rcall ENVIAR_CADENA
    ret

VOLVER_A_MOSTRAR_MENU:
    rcall MOSTRAR_MENU
    ret

ENVIAR_BYTE:
    lds r17, UCSR0A
    sbrs r17, UDRE0
    rjmp ENVIAR_BYTE
    sts UDR0, r16
    ret

ENVIAR_CADENA:
    lpm r16, Z+
    tst r16
    breq FIN_CADENA
    rcall ENVIAR_BYTE
    rjmp ENVIAR_CADENA

FIN_CADENA:
    ret

MOSTRAR_MENU:
    ldi r30, low(TEXTO_MENU_1*2)
    ldi r31, high(TEXTO_MENU_1*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_2*2)
    ldi r31, high(TEXTO_MENU_2*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_3*2)
    ldi r31, high(TEXTO_MENU_3*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_4*2)
    ldi r31, high(TEXTO_MENU_4*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_5*2)
    ldi r31, high(TEXTO_MENU_5*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_6*2)
    ldi r31, high(TEXTO_MENU_6*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_7*2)
    ldi r31, high(TEXTO_MENU_7*2)
    rcall ENVIAR_CADENA
    ldi r30, low(TEXTO_MENU_8*2)
    ldi r31, high(TEXTO_MENU_8*2)
    rcall ENVIAR_CADENA
    ret

TEXTO_MENU_1:
