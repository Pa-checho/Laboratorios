.include "m328pdef.inc"

.org 0x0000
    rjmp inicio

inicio:
    ;PC0, PC1 y PC2 como entradas
    clr r16
    out DDRC, r16

    ;Pull-up en PC0, PC1 y PC2
    ldi r16, 0b00000111
    out PORTC, r16

    ;USART a 9600 baudios con 16 MHz
    ldi r16, 103
    sts UBRR0L, r16

    ldi r16, 0
    sts UBRR0H, r16

    ;Habilitar transmisor
    ldi r16, (1<<TXEN0)
    sts UCSR0B, r16

    ;8 bits, sin paridad, 1 bit de parada
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16

bucle:
    ;Leer PC0-PC2
    in r17, PINC
    andi r17, 0b00000111

    ;Invertir logica de los switch
    com r17
    andi r17, 0b00000111

esperar:
    lds r18, UCSR0A
    sbrs r18, UDRE0
    rjmp esperar

    ;Transmitir valor
    sts UDR0, r17

    rjmp bucle
