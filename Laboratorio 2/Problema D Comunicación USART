---------------
ARDUINO MAESTRO
---------------

.include "m328pdef.inc"

.org 0x0000
    rjmp inicio

inicio:
    ;PC0, PC1 y PC2 como entradas
    clr r16
    out DDRC, r16

    ;Pull-up en PC0, PC1 y PC2
    ldi r16, 0b00000111
    out PORTC, r16

    ;USART a 9600 baudios con 16 MHz
    ldi r16, 103
    sts UBRR0L, r16

    ldi r16, 0
    sts UBRR0H, r16

    ;Habilitar transmisor
    ldi r16, (1<<TXEN0)
    sts UCSR0B, r16

    ;8 bits, sin paridad, 1 bit de parada
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16

bucle_principal:
    ;Se lee todo el Puerto C y se guarda en r17.
    in r17, PINC

    ;La mascara 00000111 elimina los bits que no
    ;orresponden a PC0, PC1 y PC2.
    andi r17, 0b00000111
    com r17

    ;COM invierte los 8 bits del registro, por eso
    ;se vuelve a aplicar la mascara.
    ;
    ;El resultado final siempre queda entre:
    ;
    ;00000000 = 0
    ;y
    ;00000111 = 7
    ;
    ;Es decir, tenemos 3 bits de informacion util.
    andi r17, 0b00000111


esperar_tx:
    lds r18, UCSR0A
    sbrs r18, UDRE0
    rjmp esperar_tx

    ;el maestro transmite un valor
    ;de 3 bits (0 a 7) contenido dentro de una
    ;trama USART de 8 bits.
    sts UDR0, r17

    ;Volver a leer los switches y enviar
    ;nuevamente su estado.
    rjmp bucle_principal

------------------
ARDUINO ESCLAVO
------------------

.include "m328pdef.inc"

.org 0x0000
    rjmp inicio

inicio:
    ; Configurar LEDs
    ldi r16, 0b00111111
    out DDRB, r16

    ldi r16, 0b00000011
    out DDRC, r16

    ; Apagar LEDs
    clr r16
    out PORTB, r16
    out PORTC, r16

    ; Configurar USART a 9600 baudios
    ldi r16, 103
    sts UBRR0L, r16

    ldi r16, 0
    sts UBRR0H, r16

    ; Habilitar receptor
    ldi r16, (1<<RXEN0)
    sts UCSR0B, r16

    ; 8 bits, sin paridad, 1 bit de parada
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16


esperar_rx:
    ; Esperar dato
    lds r18, UCSR0A
    sbrs r18, RXC0
    rjmp esperar_rx

    ; Leer dato
    lds r17, UDR0

    ; Apagar LEDs
    clr r16
    out PORTB, r16
    out PORTC, r16

    cpi r17, 0
    breq led0
    cpi r17, 1
    breq led1
    cpi r17, 2
    breq led2
    cpi r17, 3
    breq led3
    cpi r17, 4
    breq led4
    cpi r17, 5
    breq led5
    cpi r17, 6
    breq led6
    cpi r17, 7
    breq led

    rjmp esperar_rx

led0:
    ldi r16, 0b00000001
    out PORTB, r16
    rjmp esperar_rx

led1:
    ldi r16, 0b00000010
    out PORTB, r16
    rjmp esperar_rx

led2:
    ldi r16, 0b00000100
    out PORTB, r16
    rjmp esperar_rx

led3:
    ldi r16, 0b00001000
    out PORTB, r16
    rjmp esperar_rx

led4:
    ldi r16, 0b00010000
    out PORTB, r16
    rjmp esperar_rx

led5:
    ldi r16, 0b00100000
    out PORTB, r16
    rjmp esperar_rx

led6:
    ldi r16, 0b00000001
    out PORTC, r16
    rjmp esperar_rx

led7:
    ldi r16, 0b00000010
    out PORTC, r16
    rjmp esperar_rx
