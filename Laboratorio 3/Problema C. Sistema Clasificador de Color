// Bloque 2: calibracion de cuatro colores y persistencia en EEPROM.
// Monitor Serie: 9600 baudios, con fin de linea para enviar comandos.

#include <Arduino.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Adafruit_NeoPixel.h>
#include <EEPROM.h>
#include <stddef.h>
#include <string.h>
#include <ctype.h>

// ---------- Pines y componentes ----------
const byte PIN_LDR   = A0;
const byte PIN_LED   = 6;   // DIN de la matriz WS2812
const byte PIN_BOTON = 2;

const byte DIRECCION_LCD = 0x27;
const byte BRILLO = 100;
const byte CANTIDAD_PIXELES = 64; // Matriz 8x8
const byte LED_SENSOR = 0;       // Pixel usado durante la medicion
const byte MUESTRAS_LDR = 24;
const byte CANTIDAD_COLORES = 4;
const byte CANTIDAD_REFERENCIAS = 4;

// ---------- Objetos y estado ----------
LiquidCrystal_I2C lcd(DIRECCION_LCD, 16, 2);
Adafruit_NeoPixel led(
  CANTIDAD_PIXELES,
  PIN_LED,
  NEO_GRB + NEO_KHZ800
);

// ---------- Calibracion guardada en EEPROM ----------
struct Calibracion {
  uint16_t firma;
  byte version;
  byte brillo;
  uint16_t referencia[CANTIDAD_REFERENCIAS][3];
  uint16_t crc;
};

const uint16_t FIRMA_CALIBRACION = 0xC031;
const byte VERSION_CALIBRACION = 4;

Calibracion calibracion;
Calibracion candidata;

bool lcdDisponible = false;
bool calibrado = false;
bool comandoLargo = false;
bool botonYaAtendido = false;
byte modo = 0; // 0: menu y lectura cruda; 1: calibracion.
byte pasoCal = 0;
uint16_t lectura[3] = {0, 0, 0};
char comando[64];
size_t longitud = 0;

const char *NOMBRES[CANTIDAD_COLORES] = {
  "ROJO", "VERDE", "AZUL", "AMARILLO"
};

const char *nombre(byte codigo) {
  if (codigo < CANTIDAD_COLORES) return NOMBRES[codigo];
  return "SIN MUESTRA";
}

uint16_t calcularCRC(const Calibracion &datos) {
  const byte *bytes = reinterpret_cast<const byte *>(&datos);
  uint16_t crc = 0xFFFF;

  for (size_t i = 0; i < offsetof(Calibracion, crc); i++) {
    crc ^= bytes[i];

    for (byte bit = 0; bit < 8; bit++) {
      if (crc & 1) crc = (crc >> 1) ^ 0xA001;
      else crc >>= 1;
    }
  }

  return crc;
}

// ---------- Pantalla e iluminacion ----------
void pantalla(const char *linea1, const char *linea2) {
  if (!lcdDisponible) return;

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(linea1);
  lcd.setCursor(0, 1);
  lcd.print(linea2);
}

// Enciende un solo pixel durante la medicion y apaga los demas.
void iluminarUnLed(byte rojo, byte verde, byte azul) {
  for (byte i = 0; i < CANTIDAD_PIXELES; i++) {
    led.setPixelColor(i, 0);
  }

  led.setPixelColor(LED_SENSOR, led.Color(rojo, verde, azul));
  led.show();
}

void iluminarTodos(byte rojo, byte verde, byte azul) {
  uint32_t color = led.Color(rojo, verde, azul);

  for (byte i = 0; i < CANTIDAD_PIXELES; i++) {
    led.setPixelColor(i, color);
  }

  led.show();
}

// El circuito RC filtra el rebote.
// Evita repetir la lectura mientras se mantiene apretado el boton.
bool botonPresionado() {
  if (digitalRead(PIN_BOTON) == HIGH) {
    botonYaAtendido = false;
    return false;
  }

  if (!botonYaAtendido) {
    botonYaAtendido = true;
    return true;
  }

  return false;
}

// Ilumina con rojo, verde y azul y promedia 24 lecturas por canal.
void medirRGB(uint16_t destino[3]) {
  const byte colores[3][3] = {
    {BRILLO, 0, 0},
    {0, BRILLO, 0},
    {0, 0, BRILLO}
  };

  for (byte color = 0; color < 3; color++) {
    iluminarUnLed(
      colores[color][0],
      colores[color][1],
      colores[color][2]
    );

    delay(250);

    uint32_t suma = 0;
    for (byte i = 0; i < MUESTRAS_LDR; i++) {
      suma += analogRead(PIN_LDR);
      delay(10);
    }

    destino[color] = suma / MUESTRAS_LDR;
  }

  iluminarTodos(0, 0, 0);
}

// En esta etapa se muestran las lecturas crudas para comprobar el sensor.
void mostrarLectura() {
  Serial.print(F("Lectura RGB: R="));
  Serial.print(lectura[0]);
  Serial.print(F(" G="));
  Serial.print(lectura[1]);
  Serial.print(F(" B="));
  Serial.println(lectura[2]);

  pantalla("Lectura RGB lista", "Ver datos Serial");
}

// ---------- Menu y calibracion ----------
void mostrarMenu() {
  modo = 0;
  iluminarTodos(0, 0, 0);

  Serial.println();
  Serial.println(F("=== CALIBRACION DE COLORES ==="));
  Serial.println(F("  calibrar    para calibrar los 4 colores"));
  Serial.println(F("  listo       para tomar el patron solicitado"));
  Serial.println(F("  referencias para ver la calibracion"));
  Serial.println(F("  menu        para volver o cancelar la calibracion"));
  Serial.println(F("En el menu, el boton permite consultar una lectura RGB."));
  pantalla("Calibracion RGB", "Ver menu Serial");
}

void pedirMuestra() {
  if (pasoCal >= CANTIDAD_COLORES) return;

  Serial.println();
  Serial.print(F("Coloque una muestra "));
  Serial.print(nombre(pasoCal));
  Serial.println(F(" y escriba listo."));
  pantalla("Calibrar:", nombre(pasoCal));
}

void tomarPatron() {
  if (pasoCal >= CANTIDAD_COLORES) return;

  Serial.print(F("Midiendo patron "));
  Serial.println(nombre(pasoCal));
  pantalla("Midiendo patron", nombre(pasoCal));
  medirRGB(lectura);

  for (byte canal = 0; canal < 3; canal++) {
    candidata.referencia[pasoCal][canal] = lectura[canal];
  }

  Serial.print(F("Referencia guardada: "));
  Serial.println(nombre(pasoCal));
  pasoCal++;

  if (pasoCal < CANTIDAD_COLORES) {
    pedirMuestra();
    return;
  }

  // Reemplaza la calibracion anterior solo al completar los cuatro patrones.
  candidata.firma = FIRMA_CALIBRACION;
  candidata.version = VERSION_CALIBRACION;
  candidata.brillo = BRILLO;
  candidata.crc = calcularCRC(candidata);
  calibracion = candidata;
  EEPROM.put(0, calibracion);
  calibrado = true;
  modo = 0;

  Serial.println(F("Calibracion completa y guardada en EEPROM."));
  pantalla("Calibracion", "completa");
}

void imprimirReferencias() {
  if (!calibrado) {
    Serial.println(F("Todavia no hay una calibracion valida."));
    return;
  }

  Serial.println();
  Serial.println(F("=== REFERENCIAS RGB ==="));
  for (byte patron = 0; patron < CANTIDAD_REFERENCIAS; patron++) {
    Serial.print(nombre(patron));
    Serial.print(F(": R="));
    Serial.print(calibracion.referencia[patron][0]);
    Serial.print(F(" G="));
    Serial.print(calibracion.referencia[patron][1]);
    Serial.print(F(" B="));
    Serial.println(calibracion.referencia[patron][2]);
  }
}

// ---------- Comandos por Monitor Serie ----------
void procesarComando(char *texto) {
  while (*texto == ' ') texto++;

  size_t n = strlen(texto);
  while (n && texto[n - 1] == ' ') texto[--n] = 0;
  for (size_t i = 0; i < n; i++) {
    texto[i] = tolower((unsigned char)texto[i]);
  }

  if (!n) return;

  if (!strcmp(texto, "menu")) {
    mostrarMenu();
    return;
  }

  if (!strcmp(texto, "referencias")) {
    imprimirReferencias();
    return;
  }

  if (!strcmp(texto, "calibrar") || !strcmp(texto, "1")) {
    modo = 1;
    pasoCal = 0;
    memset(&candidata, 0, sizeof(candidata));
    iluminarTodos(0, 0, 0);
    pedirMuestra();
    return;
  }

  if (modo == 1 && !strcmp(texto, "listo")) {
    tomarPatron();
    return;
  }

  Serial.println(F("Comando no valido. Use calibrar, listo, referencias o menu."));
}

void leerComandos() {
  while (Serial.available()) {
    char caracter = Serial.read();

    if (caracter == '\n' || caracter == '\r') {
      if (comandoLargo) {
        Serial.println(F("Comando demasiado largo. Escribalo de nuevo."));
      } else if (longitud > 0) {
        comando[longitud] = 0;
        procesarComando(comando);
      }

      longitud = 0;
      comandoLargo = false;
    } else if (caracter == 8 || caracter == 127) {
      if (longitud) longitud--;
    } else if (longitud < sizeof(comando) - 1) {
      comando[longitud++] = caracter;
    } else {
      comandoLargo = true;
    }
  }
}

// ---------- Inicio y ciclo principal ----------
void setup() {
  Serial.begin(9600);

  pinMode(PIN_LDR, INPUT);
  pinMode(PIN_BOTON, INPUT); // Pull-up externo de 10 kOhm y filtro RC.
  analogReference(DEFAULT);

  led.begin();
  led.setBrightness(255);
  iluminarTodos(0, 0, 0);

  Wire.begin();

#if defined(WIRE_HAS_TIMEOUT)
  Wire.setWireTimeout(25000, true);
#endif

  Wire.beginTransmission(DIRECCION_LCD);
  lcdDisponible = (Wire.endTransmission() == 0);

  if (lcdDisponible) {
    lcd.begin();
    lcd.backlight();
  } else {
    Serial.println(F("LCD sin respuesta: revise direccion y cables."));
  }

  EEPROM.get(0, calibracion);
  calibrado =
    calibracion.firma == FIRMA_CALIBRACION &&
    calibracion.version == VERSION_CALIBRACION &&
    calibracion.brillo == BRILLO &&
    calibracion.crc == calcularCRC(calibracion);

  mostrarMenu();
  if (calibrado) {
    Serial.println(F("Calibracion recuperada de EEPROM."));
  } else {
    Serial.println(F("Sin calibracion valida. Escriba calibrar para comenzar."));
  }
}

void loop() {
  leerComandos();

  // Durante la calibracion, las muestras se toman solo con el comando listo.
  bool presionado = botonPresionado();
  if (modo == 0 && presionado) {
    pantalla("MIDIENDO RGB...", "Mantenga muestra");
    Serial.println(F("Midiendo muestra..."));
    medirRGB(lectura);
    mostrarLectura();
  }
}
