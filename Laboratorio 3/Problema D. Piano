/*
  Laboratorio 3 - Problema D: piano con Arduino Uno, a 16 MHz.
  Botones a GND: Do D2, Re D3, Mi D4, Fa D5, Sol D6, La D7, Si D8, Do agudo D10.
  Buzzers pasivos con transistores: D9 y D11.
  Timer0 lleva el tiempo; Timer1 y Timer2 generan los dos sonidos.
  Programa en C con main() propio.
*/

#define SIN_NOTA 255u
#define SILENCIO 0u

