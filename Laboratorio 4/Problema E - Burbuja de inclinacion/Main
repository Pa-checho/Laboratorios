/*
 * EJERCICIO E - BURBUJA DE INCLINACION
 * VERSION 1: MPU6050 + filtro complementario + LCD + monitor serial
 */

#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/twi.h>
#include <util/delay.h>
#include <stdint.h>
#include <string.h>
#include <math.h>

#define UART_BAUD              9600UL
#define UART_UBRR              ((F_CPU / (16UL * UART_BAUD)) - 1UL)

#define MPU6050_ADDRESS        0x68U
#define MPU_REG_ACCEL_XOUT_H   0x3BU
#define MPU_REG_CONFIG         0x1AU
#define MPU_REG_GYRO_CONFIG    0x1BU
#define MPU_REG_ACCEL_CONFIG   0x1CU
#define MPU_REG_PWR_MGMT_1     0x6BU
#define MPU_REG_WHO_AM_I       0x75U

#define LCD_BACKLIGHT          0x08U

#define SAMPLE_PERIOD_MS       10UL
#define DISPLAY_PERIOD_MS      100UL
#define SERIAL_PERIOD_MS       100UL
#define MPU_RETRY_PERIOD_MS    1000UL

#define FILTER_ALPHA           0.98f
#define SAMPLE_TIME_SECONDS    0.010f
#define RAD_TO_DEG             57.2957795f

typedef enum {
    ESTADO_INICIALIZACION,
    ESTADO_MEDICION,
    ESTADO_ERROR_SENSOR
} estado_t;

static volatile uint32_t tiempo_ms = 0;

static estado_t estado = ESTADO_INICIALIZACION;

static uint8_t lcd_i2c_address = 0;
static char lcd_ultima_linea_1[16];
static char lcd_ultima_linea_2[16];

static float pitch = 0.0f;
static float roll = 0.0f;
static uint8_t filtro_inicializado = 0;
static uint8_t errores_mpu_consecutivos = 0;

/* ======================================================
   TEMPORIZADOR DE 1 ms
   ========================================================= */

ISR(TIMER0_COMPA_vect)
{
    tiempo_ms++;
}

static void timer0_init(void)
{
    TCCR0A = (1 << WGM01);
    TCCR0B = (1 << CS01) | (1 << CS00);
    OCR0A = 249;
    TIMSK0 = (1 << OCIE0A);
}

static uint32_t millis_read(void)
{
    uint32_t value;
    uint8_t previous_sreg = SREG;

    cli();
    value = tiempo_ms;
    SREG = previous_sreg;

    return value;
}

/* ================================
   UART
   ================================ */

static void uart_init(void)
{
    UBRR0H = (uint8_t)(UART_UBRR >> 8);
    UBRR0L = (uint8_t)UART_UBRR;

    UCSR0A = 0;
    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

static void uart_send_char(char value)
{
    while (!(UCSR0A & (1 << UDRE0))) {
    }

    UDR0 = value;
}

static void uart_send_text(const char *text)
{
    while (*text != '\0') {
        uart_send_char(*text++);
    }
}

/* ===========================
   I2C / TWI
   =========================== */

static void twi_init(void)
{
    TWSR = 0;
    TWBR = (uint8_t)(((F_CPU / 100000UL) - 16UL) / 2UL);
    TWCR = (1 << TWEN);
}

static uint8_t twi_start(uint8_t address_byte)
{
    uint8_t status;

    TWCR = (1 << TWINT) | (1 << TWSTA) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT))) {
    }

    status = TWSR & 0xF8U;

    if (status != TW_START && status != TW_REP_START) {
        return 0;
    }

    TWDR = address_byte;
    TWCR = (1 << TWINT) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT))) {
    }

    status = TWSR & 0xF8U;

    if (address_byte & 0x01U) {
        return status == TW_MR_SLA_ACK;
    }

    return status == TW_MT_SLA_ACK;
}

static uint8_t twi_write(uint8_t value)
{
    TWDR = value;
    TWCR = (1 << TWINT) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT))) {
    }

    return (TWSR & 0xF8U) == TW_MT_DATA_ACK;
}

static uint8_t twi_read_ack(void)
{
    TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWEA);

    while (!(TWCR & (1 << TWINT))) {
    }

    return TWDR;
}

static uint8_t twi_read_nack(void)
{
    TWCR = (1 << TWINT) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT))) {
    }

    return TWDR;
}

static void twi_stop(void)
{
    TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWSTO);

    while (TWCR & (1 << TWSTO)) {
    }
}

static uint8_t i2c_probe(uint8_t address)
{
    uint8_t responded;

    responded = twi_start((uint8_t)(address << 1));
    twi_stop();

    return responded;
}

static uint8_t i2c_write_register(
    uint8_t address,
    uint8_t register_address,
    uint8_t value)
{
    if (!twi_start((uint8_t)(address << 1))) {
        twi_stop();
        return 0;
    }

    if (!twi_write(register_address)) {
        twi_stop();
        return 0;
    }

    if (!twi_write(value)) {
        twi_stop();
        return 0;
    }

    twi_stop();
    return 1;
}

static uint8_t i2c_read_registers(
    uint8_t address,
    uint8_t register_address,
    uint8_t *data,
    uint8_t length)
{
    uint8_t i;

    if (length == 0) {
        return 0;
    }

    if (!twi_start((uint8_t)(address << 1))) {
        twi_stop();
        return 0;
    }

    if (!twi_write(register_address)) {
        twi_stop();
        return 0;
    }

    if (!twi_start((uint8_t)((address << 1) | 0x01U))) {
        twi_stop();
        return 0;
    }

    for (i = 0; i < length; i++) {
        if (i < (uint8_t)(length - 1U)) {
            data[i] = twi_read_ack();
        } else {
            data[i] = twi_read_nack();
        }
    }

    twi_stop();
    return 1;
}

/* ===================================
   LCD 16x2 CON PCF8574
   ==================================== */

static uint8_t lcd_find_i2c_address(void)
{
    uint8_t address;

    for (address = 0x20U; address <= 0x27U; address++) {
        if (i2c_probe(address)) {
            return address;
        }
    }

    for (address = 0x38U; address <= 0x3FU; address++) {
        if (i2c_probe(address)) {
            return address;
        }
    }

    return 0;
}

static uint8_t lcd_write_expander(uint8_t value)
{
    if (lcd_i2c_address == 0) {
        return 0;
    }

    if (!twi_start((uint8_t)(lcd_i2c_address << 1))) {
        twi_stop();
        return 0;
    }

    if (!twi_write(value)) {
        twi_stop();
        return 0;
    }

    twi_stop();
    return 1;
}

static void lcd_write_nibble(uint8_t nibble, uint8_t register_select)
{
    uint8_t value;

    value = (uint8_t)(
        (nibble & 0xF0U) |
        LCD_BACKLIGHT |
        register_select
    );

    lcd_write_expander((uint8_t)(value | 0x04U));
    _delay_us(1);
    lcd_write_expander(value);
    _delay_us(50);
}

static void lcd_send(uint8_t value, uint8_t register_select)
{
    lcd_write_nibble(value, register_select);
    lcd_write_nibble((uint8_t)(value << 4), register_select);
}

static void lcd_command(uint8_t command)
{
    lcd_send(command, 0);

    if (command == 0x01U || command == 0x02U) {
        _delay_ms(2);
    }
}

static void lcd_data(uint8_t data)
{
    lcd_send(data, 0x01U);
}

static void lcd_init(void)
{
    memset(lcd_ultima_linea_1, 0, sizeof(lcd_ultima_linea_1));
    memset(lcd_ultima_linea_2, 0, sizeof(lcd_ultima_linea_2));

    _delay_ms(50);

    lcd_i2c_address = lcd_find_i2c_address();

    if (lcd_i2c_address == 0) {
        return;
    }

    lcd_write_nibble(0x30U, 0);
    _delay_ms(5);

    lcd_write_nibble(0x30U, 0);
    _delay_us(150);

    lcd_write_nibble(0x30U, 0);
    _delay_us(150);

    lcd_write_nibble(0x20U, 0);
    _delay_us(150);

    lcd_command(0x28U);
    lcd_command(0x0CU);
    lcd_command(0x01U);
    lcd_command(0x06U);
}

static void lcd_format_line(char line[16], const char *text)
{
    uint8_t i = 0;

    while (i < 16U && text[i] != '\0') {
        line[i] = text[i];
        i++;
    }

    while (i < 16U) {
        line[i++] = ' ';
    }
}

static void lcd_write_line(
    uint8_t row,
    const char line[16],
    char previous[16])
{
    uint8_t i;

    if (lcd_i2c_address == 0) {
        return;
    }

    if (memcmp(line, previous, 16) == 0) {
        return;
    }

    lcd_command((uint8_t)(0x80U | (row == 0 ? 0x00U : 0x40U)));

    for (i = 0; i < 16U; i++) {
        lcd_data((uint8_t)line[i]);
    }

    memcpy(previous, line, 16);
}

/* Convierte, por ejemplo, 12.34 grados en "+12.3". */
static void format_angle(float angle, char text[6])
{
    int16_t value;
    uint16_t magnitude;

    if (angle > 99.9f) {
        angle = 99.9f;
    } else if (angle < -99.9f) {
        angle = -99.9f;
    }

    if (angle >= 0.0f) {
        value = (int16_t)(angle * 10.0f + 0.5f);
        text[0] = '+';
    } else {
        value = (int16_t)(angle * 10.0f - 0.5f);
        text[0] = '-';
    }

    magnitude = value < 0
        ? (uint16_t)(-value)
        : (uint16_t)value;

    text[1] = (char)('0' + ((magnitude / 100U) % 10U));
    text[2] = (char)('0' + ((magnitude / 10U) % 10U));
    text[3] = '.';
    text[4] = (char)('0' + (magnitude % 10U));
    text[5] = '\0';
}

static void lcd_show_initialization(void)
{
    char line1[16];
    char line2[16];

    lcd_format_line(line1, "INICIALIZANDO");
    lcd_format_line(line2, "BUSCANDO MPU6050");

    lcd_write_line(0, line1, lcd_ultima_linea_1);
    lcd_write_line(1, line2, lcd_ultima_linea_2);
}

static void lcd_show_error(void)
{
    char line1[16];
    char line2[16];

    lcd_format_line(line1, "ERROR MPU6050");
    lcd_format_line(line2, "REINTENTO I2C");

    lcd_write_line(0, line1, lcd_ultima_linea_1);
    lcd_write_line(1, line2, lcd_ultima_linea_2);
}

static void lcd_show_angles(void)
{
    char line1[16];
    char line2[16];
    char pitch_text[6];
    char roll_text[6];

    uint8_t i;

    format_angle(pitch, pitch_text);
    format_angle(roll, roll_text);

    for (i = 0; i < 16U; i++) {
        line1[i] = ' ';
    }

    line1[0] = 'P';
    line1[1] = ':';
    memcpy(&line1[2], pitch_text, 5);

    line1[7] = ' ';

    line1[8] = 'R';
    line1[9] = ':';
    memcpy(&line1[10], roll_text, 5);

    lcd_format_line(line2, "ESTADO:MEDICION");

    lcd_write_line(0, line1, lcd_ultima_linea_1);
    lcd_write_line(1, line2, lcd_ultima_linea_2);
}

/* ==================================
   MPU6050
   ================================== */

static uint8_t mpu6050_read_who_am_i(uint8_t *identity)
{
    return i2c_read_registers(
        MPU6050_ADDRESS,
        MPU_REG_WHO_AM_I,
        identity,
        1
    );
}

static uint8_t mpu6050_init(void)
{
    uint8_t identity;

    if (!mpu6050_read_who_am_i(&identity)) {
        return 0;
    }

    if (identity != 0x68U && identity != 0x69U) {
        return 0;
    }

    /* Despierta el MPU6050 y selecciona el reloj interno. */
    if (!i2c_write_register(
        MPU6050_ADDRESS,
        MPU_REG_PWR_MGMT_1,
        0x00U)) {
        return 0;
    }

    _delay_ms(100);

    /* Filtro digital interno del sensor. */
    if (!i2c_write_register(
        MPU6050_ADDRESS,
        MPU_REG_CONFIG,
        0x03U)) {
        return 0;
    }

    /* Giroscopio en escala de +/-250 grados por segundo. */
    if (!i2c_write_register(
        MPU6050_ADDRESS,
        MPU_REG_GYRO_CONFIG,
        0x00U)) {
        return 0;
    }

    /* Acelerómetro en escala de +/-2 g. */
    if (!i2c_write_register(
        MPU6050_ADDRESS,
        MPU_REG_ACCEL_CONFIG,
        0x00U)) {
        return 0;
    }

    return 1;
}

static uint8_t mpu6050_read_raw(
    int16_t *accel_x,
    int16_t *accel_y,
    int16_t *accel_z,
    int16_t *gyro_x,
    int16_t *gyro_y,
    int16_t *gyro_z)
{
    uint8_t data[14];

    if (!i2c_read_registers(
        MPU6050_ADDRESS,
        MPU_REG_ACCEL_XOUT_H,
        data,
        sizeof(data))) {
        return 0;
    }

    *accel_x = (int16_t)(
        ((uint16_t)data[0] << 8) |
        data[1]
    );

    *accel_y = (int16_t)(
        ((uint16_t)data[2] << 8) |
        data[3]
    );

    *accel_z = (int16_t)(
        ((uint16_t)data[4] << 8) |
        data[5]
    );

    *gyro_x = (int16_t)(
        ((uint16_t)data[8] << 8) |
        data[9]
    );

    *gyro_y = (int16_t)(
        ((uint16_t)data[10] << 8) |
        data[11]
    );

    *gyro_z = (int16_t)(
        ((uint16_t)data[12] << 8) |
        data[13]
    );

    return 1;
}

static uint8_t update_angles(void)
{
    int16_t raw_accel_x;
    int16_t raw_accel_y;
    int16_t raw_accel_z;
    int16_t raw_gyro_x;
    int16_t raw_gyro_y;
    int16_t raw_gyro_z;

    float accel_x;
    float accel_y;
    float accel_z;
    float gyro_x_rate;
    float gyro_y_rate;
    float pitch_accel;
    float roll_accel;

    (void)raw_gyro_z;

    if (!mpu6050_read_raw(
        &raw_accel_x,
        &raw_accel_y,
        &raw_accel_z,
        &raw_gyro_x,
        &raw_gyro_y,
        &raw_gyro_z)) {
        return 0;
    }

    accel_x = (float)raw_accel_x / 16384.0f;
    accel_y = (float)raw_accel_y / 16384.0f;
    accel_z = (float)raw_accel_z / 16384.0f;

    gyro_x_rate = (float)raw_gyro_x / 131.0f;
    gyro_y_rate = (float)raw_gyro_y / 131.0f;

    pitch_accel = atan2f(
        -accel_x,
        sqrtf((accel_y * accel_y) + (accel_z * accel_z))
    ) * RAD_TO_DEG;

    roll_accel = atan2f(accel_y, accel_z) * RAD_TO_DEG;

    if (!filtro_inicializado) {
        pitch = pitch_accel;
        roll = roll_accel;
        filtro_inicializado = 1;
    } else {
        pitch = FILTER_ALPHA *
            (pitch + gyro_y_rate * SAMPLE_TIME_SECONDS) +
            (1.0f - FILTER_ALPHA) * pitch_accel;

        roll = FILTER_ALPHA *
            (roll + gyro_x_rate * SAMPLE_TIME_SECONDS) +
            (1.0f - FILTER_ALPHA) * roll_accel;
    }

    return 1;
}

/* ==================================
   INFORMACION POR MONITOR SERIAL
   ==================================== */

static void serial_show_angles(void)
{
    char pitch_text[6];
    char roll_text[6];

    format_angle(pitch, pitch_text);
    format_angle(roll, roll_text);

    uart_send_text("PITCH:");
    uart_send_text(pitch_text);
    uart_send_text(";ROLL:");
    uart_send_text(roll_text);
    uart_send_text(";ESTADO:MEDICION\r\n");
}

/* =================================
   MAQUINA DE ESTADOS - VERSION 1
   ================================= */

static void enter_state(estado_t new_state)
{
    estado = new_state;

    switch (estado) {
        case ESTADO_INICIALIZACION:
            lcd_show_initialization();
            uart_send_text("ESTADO:INICIALIZACION\r\n");
            break;

        case ESTADO_MEDICION:
            errores_mpu_consecutivos = 0;
            filtro_inicializado = 0;
            uart_send_text("ESTADO:MEDICION\r\n");
            break;

        case ESTADO_ERROR_SENSOR:
            lcd_show_error();
            uart_send_text("ESTADO:ERROR_SENSOR\r\n");
            break;

        default:
            break;
    }
}

/* ===============================
   PROGRAMA PRINCIPAL
   ================================ */

int main(void)
{
    uint32_t last_sample_time = 0;
    uint32_t last_display_time = 0;
    uint32_t last_serial_time = 0;
    uint32_t last_retry_time = 0;
    uint32_t now;

    uart_init();
    twi_init();
    lcd_init();
    timer0_init();

    sei();

    enter_state(ESTADO_INICIALIZACION);

    while (1) {
        now = millis_read();

        switch (estado) {
            case ESTADO_INICIALIZACION:
                if (mpu6050_init()) {
                    enter_state(ESTADO_MEDICION);

                    last_sample_time = now;
                    last_display_time = now;
                    last_serial_time = now;
                } else {
                    last_retry_time = now;
                    enter_state(ESTADO_ERROR_SENSOR);
                }
                break;

            case ESTADO_MEDICION:
                if ((uint32_t)(now - last_sample_time) >=
                    SAMPLE_PERIOD_MS) {

                    last_sample_time += SAMPLE_PERIOD_MS;

                    if (update_angles()) {
                        errores_mpu_consecutivos = 0;
                    } else {
                        errores_mpu_consecutivos++;

                        if (errores_mpu_consecutivos >= 3U) {
                            last_retry_time = now;
                            enter_state(ESTADO_ERROR_SENSOR);
                        }
                    }
                }

                if ((uint32_t)(now - last_display_time) >=
                    DISPLAY_PERIOD_MS) {

                    last_display_time = now;
                    lcd_show_angles();
                }

                if ((uint32_t)(now - last_serial_time) >=
                    SERIAL_PERIOD_MS) {

                    last_serial_time = now;
                    serial_show_angles();
                }
                break;

            case ESTADO_ERROR_SENSOR:
                if ((uint32_t)(now - last_retry_time) >=
                    MPU_RETRY_PERIOD_MS) {

                    last_retry_time = now;
                    enter_state(ESTADO_INICIALIZACION);
                }
                break;

            default:
                enter_state(ESTADO_INICIALIZACION);
                break;
        }
    }
}
