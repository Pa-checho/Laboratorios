<mxGraphModel adaptiveColors="none" background="#FFFFFF" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Máquina de estados de Moore — Laboratorio 5" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="180" y="20" width="620" height="40" as="geometry"/></mxCell>
    <mxCell id="subtitle" value="Las salidas están dentro de cada estado; las flechas indican eventos o condiciones." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="600" height="30" as="geometry"/></mxCell>
    <mxCell id="initial" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="35" y="218" width="26" height="26" as="geometry"/></mxCell>
    <mxCell id="activo" value="&lt;b&gt;ACTIVO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Ejecuta tareas periódicas&lt;br&gt;• ADC, DHT11 y Bluetooth&lt;br&gt;• LCD con datos&lt;br&gt;• LED y sounder bajo demanda" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="230" height="165" as="geometry"/></mxCell>
    <mxCell id="standby" value="&lt;b&gt;STANDBY&lt;/b&gt;&lt;br&gt;&lt;br&gt;• LCD: “Esperando...”&lt;br&gt;• ADC y DHT detenidos&lt;br&gt;• Conserva fuentes de despertar&lt;br&gt;• CPU en Idle entre eventos" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="230" height="165" as="geometry"/></mxCell>
    <mxCell id="apagado" value="&lt;b&gt;APAGADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• LCD y luz apagadas&lt;br&gt;• Periféricos no usados deshabilitados&lt;br&gt;• Salidas en condición segura&lt;br&gt;• CPU en Power-Down" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="230" height="165" as="geometry"/></mxCell>
    <mxCell id="seguro" value="&lt;b&gt;SEGURO / EMERGENCIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Suspende tareas no esenciales&lt;br&gt;• LCD muestra emergencia&lt;br&gt;• Sounder de alarma activo&lt;br&gt;• Espera recuperación válida" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;double=1;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="230" height="165" as="geometry"/></mxCell>
    <mxCell id="note" value="&lt;b&gt;t&lt;sub&gt;inac&lt;/sub&gt;&lt;/b&gt;: tiempo desde la última actividad válida.&lt;br&gt;El WDT no es un estado: como despertador provoca una tarea breve y el sistema vuelve a dormir; como reset reinicia y el firmware ingresa en SEGURO al detectar WDRF." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="810" height="70" as="geometry"/></mxCell>
    <mxCell id="e_init" value="Inicio / reset normal" edge="1" parent="1" source="initial" target="activo" style="endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_a_s" value="t_inac ≥ 10 s" edge="1" parent="1" source="activo" target="standby" style="endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_s_p" value="t_inac ≥ 30 s" edge="1" parent="1" source="standby" target="apagado" style="endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_s_a" value="Actividad válida" edge="1" parent="1" source="standby" target="activo" style="curved=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;dashed=1;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_p_a" value="Pulsador INT0 / despertar autorizado" edge="1" parent="1" source="apagado" target="activo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;dashed=1;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_a_a" value="Actividad válida: reinicia t_inac" edge="1" parent="1" source="activo" target="activo" style="curved=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_a_e" value="Emergencia local o remota" edge="1" parent="1" source="activo" target="seguro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_s_e" value="Emergencia" edge="1" parent="1" source="standby" target="seguro" style="endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_p_e" value="Emergencia" edge="1" parent="1" source="apagado" target="seguro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_e_a" value="Recuperación válida" edge="1" parent="1" source="seguro" target="activo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;dashed=1;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_p_p" value="WDT despertador: tarea breve y vuelve a dormir" edge="1" parent="1" source="apagado" target="apagado" style="curved=1;endArrow=open;endSize=10;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;defaultLabelBackgroundColor=page;"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root>
</mxGraphModel>

